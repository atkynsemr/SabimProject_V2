@model Sabim.Web.ViewModels.PersonelAyrilisViewModel
@{
    ViewData["Title"] = "Personel Ayrılışları";
}
@section StyleCss {
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/searchpanes/2.3.3/css/searchPanes.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/select/2.1.0/css/select.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/4.0.1/css/fixedHeader.bootstrap4.css">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
}
<!-- Personel İzin Ekleme Modal Başlangıç-->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header primary">
                <h5 class="modal-title" id="createModalLabel">Personel İzin Ekle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="PersonelIzinEkleForm">
                    @Html.AntiForgeryToken()
                    @await Component.InvokeAsync("_PersonelAyrilisNedenleriComponent", new { deger = "create", kaliciAyrilisMi = true })
                    <div class="form-group">
                        <label>Başlangıç Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="CreateBaslangicTarihi" name="BaslangicTarihi" asp-for="YeniPersonelAyrilis.BaslangicTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="YeniPersonelAyrilis.BaslangicTarihi" name="BaslangicTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Bitiş Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="CreateBitisTarihi" name="BitisTarihi" asp-for="YeniPersonelAyrilis.BitisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="YeniPersonelAyrilis.BitisTarihi" name="BitisTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <input type="hidden" id="CreateKaliciAyrilisMi" name="KaliciAyrilisMi" asp-for="YeniPersonelAyrilis.KaliciAyrilisMi" />
                    <input type="hidden" id="CreateDonanimUyarisi" name="DonanimUyarisi" asp-for="YeniPersonelAyrilis.DonanimUyarisi" />
                    <input type="hidden" id="CreateDurumId" name="DurumId" asp-for="YeniPersonelAyrilis.DurumId" value="1" />
                    <input type="hidden" id="CreatePersonelId" name="PersonelId" asp-for="YeniPersonelAyrilis.PersonelId" value="@Model.ListelePersonelAyrilis.PersonelID" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="KaydetPersonelIzinleriButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel İzin Ekleme Modal Bitiş-->
<!-- Personel Unvan Düzenleme Modal Başlangıç-->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
            <div class="overlay">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header warning">
                <h5 class="modal-title" id="editModalLabel">Personel İzin Düzenle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="PersonelIzinGuncelleForm">
                    @Html.AntiForgeryToken()
                    @await Component.InvokeAsync("_PersonelAyrilisNedenleriComponent", new { deger = "update", kaliciAyrilisMi = true })
                    <div class="form-group">
                        <label>Başlangıç Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="UpdateBaslangicTarihi" name="BaslangicTarihi" asp-for="GuncellePersonelAyrilis.BaslangicTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="GuncellePersonelAyrilis .BaslangicTarihi" name="BaslangicTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Bitiş Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="UpdateBitisTarihi" name="BitisTarihi" asp-for="GuncellePersonelAyrilis.BitisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="GuncellePersonelAyrilis.BitisTarihi" name="BitisTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    @await Component.InvokeAsync("_DurumListesiGenelComponent", new { deger = "update" })
                    <input type="hidden" id="UpdateKaliciAyrilisMi" name="KaliciAyrilisMi" asp-for="GuncellePersonelAyrilis.KaliciAyrilisMi" />
                    <input type="hidden" id="UpdateDonanimUyarisi" name="DonanimUyarisi" asp-for="GuncellePersonelAyrilis.DonanimUyarisi" />
                    <input type="hidden" id="UpdatePersonelId" name="PersonelId" asp-for="GuncellePersonelAyrilis.PersonelId" value="@Model.ListelePersonelAyrilis.PersonelID" />
                    <input type="hidden" id="UpdatePersonelAyrilisID" name="PersonelAyrilisID" asp-for="GuncellePersonelAyrilis.PersonelAyrilisID" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-warning" id="GuncellePersonelIzinButton">Güncelle</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel İzin Düzenleme Modal Bitiş-->
<!-- Personel İzin Silme Modal Başlangıç-->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="deleteModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header danger">
                <h5 class="modal-title" id="deleteModalLabel">Personel İzin Sil</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="PersonelAyrilisSilForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PersonelAyrilisID" id="DeletePersonelAyrilisID" />
                    <p id="PersonelAyrilisLabel">İzin Türü: <strong id="PersonelAyrilisIzinTur"></strong> Başlangıç Tarihi<strong id="PersonelAyrilisBaslangicTarihi"></strong> Bitiş Tarihi<strong id="PersonelAyrilisBitisTarihi"></strong>  silinecektir. Onaylıyor musunuz?</p>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-danger" id="SilPersonelAyrilisButton">Sil</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel İzin Silme Modal Bitiş-->
<!-- Personel İzin Safahat Modal Başlangıç-->
<div class="modal fade" id="auditTrailModal" tabindex="-1" role="dialog" aria-labelledby="auditTrailModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary">
                <h5 class="modal-title" id="auditTrailModalLabel">Safahat Bilgileri</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--Veriler Yüklenecek-->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel İzin Safahat Modal Bitiş-->
<div class="row">
    <div class="col-md-3">
        <div class="card card-primary card-outline">
            <div class="card-body box-profile">
                <div class="text-center">
                    <img class="profile-user-img img-fluid img-circle" src="https://demos.themeselection.com/sneat-bootstrap-html-admin-template/assets/img/avatars/1.png" alt="User profile picture">
                </div>
                <h3 id="PersonelAdiSoyadi" class="profile-username text-center">@Model.ListelePersonelAyrilis.AdSoyad</h3>
                <p class="text-muted text-center">@Model.ListelePersonelAyrilis.UnvanAdi</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Sicil Numarası</b> <a class="float-right">@Model.ListelePersonelAyrilis.SicilNumarasi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Çalışma Durumu</b> <a class="float-right">@Model.ListelePersonelAyrilis.CalismaDurumAdi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Kadro Yeri</b> <a class="float-right">@Model.ListelePersonelAyrilis.KurumAdi</a>
                    </li>
                </ul>
            </div>
            <!-- /.card-body -->
        </div>
    </div>
    <!-- /.col -->
    <div class="col-md-9">
        <div class="card">
            <div class="d-flex card-header">
                <a asp-area="Admin" asp-controller="Personel" asp-action="Index" class="btn btn-outline-dark btn-flat my-2">
                    <i class="fa fa-arrow-circle-left mr-1"></i> Personeller Sayfasına Dön
                </a>
                @Html.Raw(IconHelper.CreateButton("btn btn-outline-primary btn-flat my-2 ml-auto", "Personel Ayrılış", IconHelper.GetAddIcon(), "Personel Ayrılış Ekle", "createModal"))
            </div>
            <div class="card-body mt-2">
                <div id="PersonelIzinTablosu">
                    <table id="example" class="table table-striped table-bordered table-hover display text-center mt-3" style="width:100%">
                        <thead>
                            <tr>
                                <th>Ayrılış Nedeni</th>
                                <th class="text-center">Başlangıç Tarihi</th>
                                <th class="text-center">Bitiş Tarihii</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        @await Component.InvokeAsync("_PersonelAyrilisComponent", new { PersonelID = Model.ListelePersonelAyrilis.PersonelID, kaliciAyrilisMi = true, deger = "result" })
                        <tfoot>
                            <tr>
                                <th>Ayrılış Nedeni</th>
                                <th class="text-center">Başlangıç Tarihi</th>
                                <th class="text-center">Bitiş Tarihii</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!-- /.card -->
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/dataTables.searchPanes.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/searchPanes.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/dataTables.colReorder.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/colReorder.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/dataTables.fixedHeader.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/fixedHeader.bootstrap4.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.8/dist/sweetalert2.all.min.js"></script>
    <!-- Toastr -->
    <script src="/AdminTemplate/dist/js/toastr.min.js"></script>
    <!-- Custom Toastr JS-->
    <script src="/AdminTemplate/dist/js/customize/ToastCustom.js"></script>
    <!-- Custom Capitalize JS-->
    <script src="/AdminTemplate/dist/js/customize/CapitalizeCustom.js"></script>
    <!-- Custom SwalAert JS-->
    <script src="/AdminTemplate/dist/js/customize/SwalAlertCustom.js"></script>
    <!-- InputMask -->
    <script src="/AdminTemplate/plugins/jquery/jquery.inputmask.min.js"></script>
    <script>
        $(document).ready(function () {
            initDataTable();
            //Kayıt İşlemi
            $('#KaydetPersonelIzinleriButton').click(savePersonelIzinleri);
            $(".modal").on("hidden.bs.modal", function () {
                $('.modal').each(function () {
                    let modal = $(this);
                    let form = modal.find('form');
                    // Eğer form varsa, formu sıfırla
                    if (form.length) {
                        form[0].reset();
                    }
                    // Hata mesajlarını temizle
                    modal.find('span.text-danger').text('');
                });
                $('#createModal .nav-pills .nav-link').removeClass('active'); // Tüm tab'ları deaktif yap
                $('#createModal .tab-content .tab-pane').removeClass('active'); // Tüm içerik alanlarını deaktif yap
                // İlk tab'ı aktif yap
                $('#createModal .nav-pills .nav-link:first').addClass('active');
                $('#createModal .tab-content .tab-pane:first').addClass('active');
                $('#createKurumlar').val(784);
                // Overlay (arka plan) elemanını gizle
                $('.overlay').hide();
            });
            $('[data-widget="pushmenu"]').on('click', function () {
                setTimeout(function () {
                    var table = $('#example').DataTable();
                    table.columns.adjust().draw(); // Sütunları yeniden boyutlandır ve yeniden çiz
                }, 400); // Animasyon tamamlandıktan sonra
            });
            $(document).one('click', '.btn-edit', function (event) {
                event.preventDefault();
                let id = $(this).data('id');
                if (id) {
                    editPersonelIzin(id);
                }
            });
            $(document).on('click', '.btn-showinfo', function (event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    showInfoPersonelIzin(id);
                }
            });
            $(document).on('click', '.btn-delete', function (event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let PersonelAyrilisID = $(this).data('id');
                $.ajax({
                    url: `/Admin/Personel/GetPersonelAyrilisById/${PersonelAyrilisID}`,
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            const personelData = response.data;
                            console.log(personelData);
                            $('#deleteModal #DeletePersonelAyrilisID').val(personelData.personelAyrilisID);
                            $('#deleteModal #PersonelAyrilisIzinTur').text(personelData.aciklama);
                            $('#deleteModal #PersonelAyrilisBaslangicTarihi').text(changeDateFormatTo(personelData.baslangicTarihi));
                            $('#deleteModal #PersonelAyrilisBitisTarihi').text(changeDateFormatTo(personelData.bitisTarihi));
                            $('#deleteModal').modal('show'); // Modalı aç
                        } else {
                            showToast('Silinecek veri bulunamadı.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                        }
                    },
                    error: function () {
                        showToast('Silme işlemi için veri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                    }
                });
            });
            $('#datemask').inputmask('dd/mm/yyyy', { 'placeholder': 'dd/mm/yyyy' });
            $('[data-mask]').inputmask();
            // Düzenle Kaydet Butonu
            $('#GuncellePersonelIzinButton').click(saveUpdatedPersonelIzin);
            // Sil Modal'ı
            $('#SilPersonelAyrilisButton').click(deletePersonelAyrilis);
        });
        function initDataTable() {
            var personelAdiSoyadi = $("#PersonelAdiSoyadi").text().trim();
            $('#example').DataTable({
                "scrollX": true,
                "fixedHeader": true,
                "responsive": false,
                "lengthChange": false,
                "autoWidth": false,
                "lengthChange": true,
                "pageLength": 15,
                "order": [1, 'asc'],
                "language": {
                    "searchPanes": {
                        "emptyPanes": 'Filtreleme Paneli Bulunamadı',
                        "title": {
                            _: 'Seçili Alan - %d',
                            0: ''
                        },
                        "collapseMessage": 'Tümünü Kapat',
                        "showMessage": 'Hepsini Göster',
                        "clearMessage": 'Hepsini Temizle',
                        "collapse": { 0: 'Filtreleme Paneli', _: 'Filtreleme Paneli (%d)' }
                    },
                    "sProcessing": "İşleniyor...",
                    "sLengthMenu": "_MENU_",
                    "sZeroRecords": "Eşleşen Kayıt Bulunmadı",
                    "sInfo": "Toplam _TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "sInfoEmpty": "Kayıt Yok",
                    "emptyTable": "Tabloda veri bulunmamaktadır",
                    "sInfoFiltered": "(toplam _MAX_ kayıttan filtrelendi)",
                    "sSearch": "",
                    "searchPlaceholder": 'Arama Yapınız...',
                    "oPaginate": {
                        "sFirst": "İlk",
                        "sPrevious": "Önceki",
                        "sNext": "Sonraki",
                        "sLast": "Son"
                    }
                },
                colReorder: true,
                layout: {
                    topStart:
                    {
                        buttons:
                            [
                                {
                                    extend: 'searchPanes',
                                    text: '<i class="fa fa-filter mr-1"></i>Filtreleme Paneli',
                                    config: {
                                        cascadePanes: true,
                                        layout: 'columns-2',
                                        orderable: false,
                                        initCollapsed: true
                                    }
                                },
                                {
                                    extend: 'collection',
                                    text: '<i class="fas fa-upload mr-1"></i> Aktar',
                                    buttons:
                                        [
                                            {
                                                extend: 'excel',
                                                text: '<i class="fas fa-file-excel mr-1"></i> Excel',
                                                title: personelAdiSoyadi + ' - Unvan Geçmişi', // Dinamik başlık ekleme
                                                exportOptions: {
                                                    columns: function (idx, data, node) {
                                                        var table = $('#example').DataTable();
                                                        var columnHeader = table.column(idx).header().innerText.trim(); // Sütun başlığını al
                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakılacak sütunlar

                                                        return table.column(idx).visible() && !excludedColumns.includes(columnHeader);
                                                        // Yalnızca görünür ve dışlanmamış sütunları dahil et
                                                    }
                                                }
                                            },
                                            {
                                                extend: 'pdf',
                                                text: '<i class="fas fa-file-pdf mr-1"></i> PDF',
                                                title: personelAdiSoyadi + ' - Unvan Geçmişi', // Dinamik başlık ekleme
                                                exportOptions: {
                                                    columns: function (idx, data, node) {
                                                        var table = $('#example').DataTable();
                                                        var columnHeader = table.column(idx).header().innerText.trim(); // Sütun başlığını al

                                                        var includedColumns = [
                                                            'Unvan Adı',
                                                            'Unvana Sahip Olduğu Tarihi',
                                                            'Bitiş Tarihii'
                                                        ]; // PDF'e dahil edilmesi gereken sütunlar

                                                        return includedColumns.includes(columnHeader); // Yalnızca seçili başlıkları ekle
                                                    }
                                                },
                                                customize: function (doc) {
                                                    var table = $('#example').DataTable();
                                                    var includedColumns = [
                                                        'Unvan Adı',
                                                        'Unvana Sahip Olduğu Tarihi',
                                                        'Bitiş Tarihii'
                                                    ]; // PDF'de görünmesini istediğimiz sıradaki sütunlar

                                                    // PDF için tablo içeriğini yeniden oluştur
                                                    var newTableBody = [];

                                                    // Başlıkları sıraya göre düzenle
                                                    var tableHeaders = includedColumns.map(function (colName) {
                                                        return { text: colName, style: 'tableHeader', alignment: 'center' };
                                                    });
                                                    newTableBody.push(tableHeaders);

                                                    // Satırları belirtilen sıraya göre ekle
                                                    table.rows({ search: 'applied' }).every(function (rowIdx, tableLoop, rowLoop) {
                                                        var rowData = this.data();
                                                        var orderedRow = [];

                                                        includedColumns.forEach(function (colName) {
                                                            var columnIndex = table.column(`:contains("${colName}")`).index(); // Başlık ile indeks bul
                                                            orderedRow.push({ text: rowData[columnIndex], alignment: 'center' });
                                                        });

                                                        newTableBody.push(orderedRow);
                                                    });

                                                    // Yeni tabloyu PDF'e uygula
                                                    doc.content[1].table.body = newTableBody;
                                                }
                                            },

                                            {
                                                extend: 'print',
                                                text: '<i class="fas fa-print mr-1"></i> Yazdır',
                                                exportOptions: {
                                                    columns: function (idx, data, node) {
                                                        var table = $('#example').DataTable();
                                                        var columnHeader = table.column(idx).header().innerText.trim(); // Sütun başlığını al
                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakılacak sütunlar
                                                        return table.column(idx).visible() && !excludedColumns.includes(columnHeader);// Eşleşen sütun dışarıya aktarılmaz
                                                    }
                                                }
                                            }
                                        ]
                                },
                                {
                                    extend: 'colvis',
                                    columns: function (idx, data, node) {
                                        return [1].indexOf(idx) === -1;
                                    },
                                    text: '<i class="fas fa-columns mr-1"></i> Sütun Görünürlüğü'
                                }
                            ]
                    }
                },
                columnDefs: [

                    {
                        searchPanes: {
                            show: true
                        },
                        targets: [3]
                    },
                    {
                        searchPanes: {
                            show: false
                        },
                        targets: '_all'
                    }
                ]
            });
        }
        const changeDateFormatTo = date => {
            if (!date) return ''; // Eğer tarih yoksa boş döner
            const onlyDate = date.split("T")[0];
            const [yy, mm, dd] = onlyDate.split("-");
            return `${dd}/${mm}/${yy}`;
        };
        function savePersonelIzinleri() {
            $('#createModal span.text-danger').text('');
            $('#createModal .overlay').show();
            var selectedOption = document.querySelector("#createPersonelAyrilisNedenleri option:checked");
            if (selectedOption) {
                var kaliciAyrilis = selectedOption.getAttribute("data-kalici-ayrilis");
                var donanimUyarisi = selectedOption.getAttribute("data-donanim-uyarisi");
                document.getElementById("CreateKaliciAyrilisMi").value = kaliciAyrilis;
                document.getElementById("CreateDonanimUyarisi").value = donanimUyarisi;
            }
            var formData = $('#PersonelIzinEkleForm').serialize(); // Form verilerini serialize et
            $.ajax({
                url: '/Admin/Personel/EklePersonelIzin', // Hedef URL
                type: 'POST',
                data: formData,
                success: function (response) {
                    console.log(response.success);
                    if (response.success) {
                        $('#createModal').modal('hide');
                        reloadTable();
                        if (response.completeStatus) {
                            showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                        }
                        else {
                            showToast(response.message, 'Bilgi Mesajı', 'topRight', 3500, 'bg-warning', true);
                        }
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function editPersonelIzin(id) {
            // event.preventDefault();
            $.ajax({
                url: `/Admin/Personel/GetPersonelAyrilisById/${id}`,
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        const data = response.data;
                        console.log(data);
                        $('#editModal #UpdatePersonelId').val(data.personelId);
                        $('#editModal #UpdatePersonelAyrilisID').val(data.personelAyrilisID);
                        $('#UpdateKaliciAyrilisMi').val(data.kaliciAyrilisMi);
                        $('#UpdateDonanimUyarisi').val(data.donanimUyarisi);
                        $('#editModal #updatePersonelAyrilisNedenleri option').each(function() {
                            const optionValue = $(this).val();
                            if (optionValue == data.personelAyrilisNedenleriId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #UpdateBaslangicTarihi').val(changeDateFormatTo(data.baslangicTarihi));
                        $('#editModal #UpdateBitisTarihi').val(changeDateFormatTo(data.bitisTarihi));
                        $('#editModal #updateDurumlar option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.durumId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal .overlay').hide();
                        $('#editModal').modal('show');
                    }
                    else {
                        showToast('Seçili olan kayıt gösterilemiyor! Lütfen sayfayı yenileyip tekrar deneyiniz.', 'Hata', 'topRight', 3500, 'bg-danger', true);
                        $('.modal .overlay').hide();
                    }
                },
                error: function () {
                    showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu!', 'error', 3500, true, true);
                }
            });
        }
        function saveUpdatedPersonelIzin() {
            var formData = $('#PersonelIzinGuncelleForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/Personel/GuncellePersonelIzin',
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#editModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function deletePersonelAyrilis() {
            $('#deleteModal .overlay').show();
            var formData = $('#PersonelAyrilisSilForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/Personel/SilPersonelAyrilis', // Silme işlemi için endpoint
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#deleteModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        $('#deleteModal').modal('hide');
                        showToast(response.message, 'Hata Mesajı', 'topRight', 3500, 'bg-danger', true);
                    }
                },
                error: function (xhr) {
                    handleError(xhr); // Hata durumunu yönet
                }
            });
        }
        function showInfoPersonelIzin(id) {
            $.ajax({
                url: `/Admin/Personel/GetirPersonelIzinSafahatBilgi/${id}`,
                type: 'GET',
                success: function (response) {
                    $("#auditTrailModal").find(".modal-body").html(response);
                    $('#auditTrailModal').modal('show');
                },
                error: function () {
                    showToast('Safahat bilgileri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                }
            });
        }
        function reloadComponent(componentSelector, url) {
            $(componentSelector).load(url, function (response, status, xhr) {
                if (status === "error") {
                    setTimeout(function () {
                        window.location.reload(); // Sayfayı yeniden yükle
                    }, 1500);
                }
            });
        }
        function reloadTable() {
            // Eski tabloyu kaldır
            if ($.fn.DataTable.isDataTable('#example')) {
                $('#example').DataTable().destroy();
                $('#example').empty(); // DOM'u temizle
            }
            var personelID = $('#CreatePersonelId').val();
            // Tabloyu yeniden yükle
            $('#PersonelIzinTablosu').load('/Admin/Personel/PersonelIzinleri?PersonelID=' + personelID + ' #PersonelIzinTablosu', function(response, status, xhr) {
                if (status === "success") {
                    initDataTable(); // DataTable başlat
                } else if (status === "error") {
                    showToast("Tablo yüklenemedi. Lütfen sayfayı yenileyin.", "Hata", "topRight", 3500, "bg-danger", true);
                }
            });
        }
        function handleError(xhr) {
            $('.modal .overlay').hide();
            if (xhr.responseJSON && xhr.responseJSON.errors) {
                for (let key in xhr.responseJSON.errors) {
                    let errorElement = $(`[name='${key}']`).next('.text-danger');
                    errorElement.text(xhr.responseJSON.errors[key][0]);
                }
            }
            else {
                $('.modal').modal('hide'); // Tüm açık modalları kapatır
                showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
            }
        }
        document.addEventListener("DOMContentLoaded", function() {
            var tarihInput = document.getElementById("UpdateBaslangicTarihi");
            tarihInput.addEventListener("blur", function() {
                if (!tarihInput.value.trim()) { // Eğer alan tamamen boşsa
                    var today = new Date();
                    var formattedDate = today.toLocaleDateString("tr-TR"); // "17.02.2025" gibi formatlar
                    tarihInput.value = formattedDate; // Boş olan inputa bugünün tarihini ata
                }
            });
        });
    </script>
}