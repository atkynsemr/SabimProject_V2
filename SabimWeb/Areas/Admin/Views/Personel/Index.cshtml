    <script>
        $(document).ready(function () {
            window.createPersonelChoices = new Choices('#createPersonelListesi', {
                removeItemButton: true,
                maxItemCount: null, // Sınırsız seçim hakkı
                searchResultLimit: 1000,
                renderChoiceLimit: 1000,
                noResultsText: "Sonuç bulunamadı",
                noChoicesText: "Seçenek yok",
                itemSelectText: "Seçmek için tıklayın",
                uniqueItemText: "Bu seçenek zaten eklendi",
            });
            window.updatePersonelChoices = new Choices('#updatePersonelListesi', {
                removeItemButton: true,
                maxItemCount: null, // Sınırsız seçim hakkı
                searchResultLimit: 1000,
                renderChoiceLimit: 1000,
                noResultsText: "Sonuç bulunamadı",
                noChoicesText: "Seçenek yok",
                itemSelectText: "Seçmek için tıklayın",
                uniqueItemText: "Bu seçenek zaten eklendi",
            });
            initDataTable();
            //Kayıt İşlemi
            $('#KaydetPersonelButton').click(savePersonel);
            $(".modal").on("hidden.bs.modal", function () {
                $('.modal').each(function () {
                    let modal = $(this);
                    let form = modal.find('form');
                    // Eğer form varsa, formu sıfırla
                    if (form.length) {
                        form[0].reset();
                    }
                    // Hata mesajlarını temizle
                    modal.find('span.text-danger').text('');
                });
                $('#createModal .nav-pills .nav-link').removeClass('active'); // Tüm tab'ları deaktif yap
                $('#createModal .tab-content .tab-pane').removeClass('active'); // Tüm içerik alanlarını deaktif yap
                // İlk tab'ı aktif yap
                $('#createModal .nav-pills .nav-link:first').addClass('active');
                $('#createModal .tab-content .tab-pane:first').addClass('active');
                $('#createKurumlar').val(784);
                // Overlay (arka plan) elemanını gizle
                $('.overlay').hide();
            });
            $('[data-widget="pushmenu"]').on('click', function () {
                setTimeout(function () {
                    var table = $('#example').DataTable();
                    table.columns.adjust().draw(); // Sütunları yeniden boyutlandır ve yeniden çiz
                }, 400); // Animasyon tamamlandıktan sonra
            });
            $(document).one('click', '.btn-edit', function (event) {
                event.preventDefault(); // Tekrar tetiklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    editPersonel(id);
                }
            });
            $(document).on('click', '.btn-showinfo', function (event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    showInfoPersonel(id);
                }
            });
            $(document).on('click', '.btn-delete', function (event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let PersonelID = $(this).data('id');
                $.ajax({
                    url: `/Admin/Personel/GetPersonelById/${PersonelID}`,
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            const personelData = response.data;
                            $('#deleteModal #DeletePersonelID').val(personelData.personelID);
                            $('#deleteModal #PersonelAdSoyad').text(personelData.adSoyad + " (" + personelData.sicilNumarasi + ")");
                            $('#deleteModal').modal('show'); // Modalı aç
                        } else {
                            showToast('Silinecek veri bulunamadı.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                        }
                    },
                    error: function () {
                        showToast('Silme işlemi için veri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                    }
                });
            });
            $('#createSehirler').change(function () {
                var selectedSehirId = $(this).val();
                changeKurum(null, selectedSehirId, "create");
            });
            $('#updateSehirler').change(function () {
                var selectedSehirId = $(this).val();
                changeKurum(null, selectedSehirId, "update");
            });
            $('#datemask').inputmask('dd/mm/yyyy', { 'placeholder': 'dd/mm/yyyy' });
            $('[data-mask]').inputmask();
            // Düzenle Kaydet Butonu
            $('#GuncellePersonelButton').click(saveUpdatedPersonel);
            // Sil Modal'ı
            $('#SilPersonelButton').click(deletePersonel);
            $('#createUnvanlar').change(function () {
                toggleCreateKatiplerContent();
            });
            $('#updateUnvanlar').change(function() {
                toggleUpdateKatiplerContent();
            });
            toggleCreateKatiplerContent();
            toggleUpdateKatiplerContent();
        });
        function initDataTable() {
            $('#example').DataTable({
                "scrollX": true,
                "fixedHeader": true,
                "responsive": false,
                "lengthChange": false,
                "autoWidth": false,
                "lengthChange": true,
                "pageLength": 50,
                "order": [[1, 'asc'], [3, 'asc']],
                "language": {
                    "searchPanes": {
                        "emptyPanes": 'Filtreleme Paneli Bulunamadı',
                        "title": {
                            _: 'Seçili Alan - %d',
                            0: ''
                        },
                        "collapseMessage": 'Tümünü Kapat',
                        "showMessage": 'Hepsini Göster',
                        "clearMessage": 'Hepsini Temizle',
                        "collapse": { 0: 'Filtreleme Paneli', _: 'Filtreleme Paneli (%d)' }
                    },
                    "sProcessing": "İşleniyor...",
                    "sLengthMenu": "_MENU_",
                    "sZeroRecords": "Eşleşen Kayıt Bulunmadı",
                    "sInfo": "Toplam _TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "sInfoEmpty": "Kayıt Yok",
                    "emptyTable": "Tabloda veri bulunmamaktadır",
                    "sInfoFiltered": "(toplam _MAX_ kayıttan filtrelendi)",
                    "sSearch": "",
                    "searchPlaceholder": 'Arama Yapınız...',
                    "oPaginate": {
                        "sFirst": "İlk",
                        "sPrevious": "Önceki",
                        "sNext": "Sonraki",
                        "sLast": "Son"
                    }
                },
                colReorder: true,
                layout: {
                    topStart:
                    {
                        buttons:
                            [
                                {
                                    extend: 'searchPanes',
                                    text: '<i class="fa fa-filter mr-1"></i>Filtreleme Paneli',
                                    config: {
                                        cascadePanes: true,
                                        layout: 'columns-2',
                                        orderable: false,
                                        initCollapsed: true
                                    }
                                },
                                {
                                    extend: 'collection',
                                    text: '<i class="fas fa-upload mr-1"></i> Aktar',
                                    buttons:
                                        [
                                            {
                                                extend: 'excel',
                                                text: '<i class="fas fa-file-excel mr-1"></i> Excel',
                                                exportOptions: {
                                                    columns: function (idx, data, node) {
                                                        var table = $('#example').DataTable();
                                                        var columnHeader = table.column(idx).header().innerText.trim(); // Sütun başlığını al
                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakılacak sütunlar

                                                        return table.column(idx).visible() && !excludedColumns.includes(columnHeader);
                                                        // Yalnızca görünür ve dışlanmamış sütunları dahil et
                                                    }
                                                }
                                            },
                                            {
                                                extend: 'pdf',
                                                text: '<i class="fas fa-file-pdf mr-1"></i> PDF',
                                                exportOptions: {
                                                    columns: function (idx, data, node) {
                                                        var table = $('#example').DataTable();
                                                        var columnHeader = table.column(idx).header().innerText.trim(); // Sütun başlığını al

                                                        var includedColumns = [
                                                            'T.C Kimlik No',
                                                            'Sicil No',
                                                            'Ad ve Soyad',
                                                            'Unvan',
                                                            'Cep Telefonu'
                                                        ]; // PDF'e dahil edilmesi gereken sütunlar

                                                        return includedColumns.includes(columnHeader); // Yalnızca seçili başlıkları ekle
                                                    }
                                                },
                                                customize: function (doc) {
                                                    var table = $('#example').DataTable();
                                                    var includedColumns = [
                                                        'T.C Kimlik No',
                                                        'Sicil No',
                                                        'Ad ve Soyad',
                                                        'Unvan',
                                                        'Cep Telefonu'
                                                    ]; // PDF'de görünmesini istediğimiz sıradaki sütunlar

                                                    // PDF için tablo içeriğini yeniden oluştur
                                                    var newTableBody = [];

                                                    // Başlıkları sıraya göre düzenle
                                                    var tableHeaders = includedColumns.map(function (colName) {
                                                        return { text: colName, style: 'tableHeader', alignment: 'center' };
                                                    });
                                                    newTableBody.push(tableHeaders);

                                                    // Satırları belirtilen sıraya göre ekle
                                                    table.rows({ search: 'applied' }).every(function (rowIdx, tableLoop, rowLoop) {
                                                        var rowData = this.data();
                                                        var orderedRow = [];

                                                        includedColumns.forEach(function (colName) {
                                                            var columnIndex = table.column(`:contains("${colName}")`).index(); // Başlık ile indeks bul
                                                            orderedRow.push({ text: rowData[columnIndex], alignment: 'center' });
                                                        });

                                                        newTableBody.push(orderedRow);
                                                    });

                                                    // Yeni tabloyu PDF'e uygula
                                                    doc.content[1].table.body = newTableBody;
                                                }
                                            },

                                            {
                                                extend: 'print',
                                                text: '<i class="fas fa-print mr-1"></i> Yazdır',
                                                exportOptions: {
                                                    columns: function (idx, data, node) {
                                                        var table = $('#example').DataTable();
                                                        var columnHeader = table.column(idx).header().innerText.trim(); // Sütun başlığını al
                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakılacak sütunlar
                                                        return table.column(idx).visible() && !excludedColumns.includes(columnHeader);// Eşleşen sütun dışarıya aktarılmaz
                                                    }
                                                }
                                            }
                                        ]
                                },
                                {
                                    extend: 'colvis',
                                    columns: function (idx, data, node) {
                                        return [1].indexOf(idx) === -1;
                                    },
                                    text: '<i class="fas fa-columns mr-1"></i> Sütun Görünürlüğü'
                                }
                            ]
                    }
                },
                columnDefs: [
                    {
                        searchPanes: {
                            show: true,
                            dtOpts: {
                                select: {
                                    style: 'multi'
                                },
                                searching: true,
                            }
                        },
                        targets: [5, 8, 9, 11, 12, 13, 14]
                    },
                    {
                        searchPanes: {
                            show: false
                        },
                        targets: '_all'
                    },
                    {
                        targets: [7, 8, 9, 10, 12, 13, 14, 15, 18, 19],
                        visible: false
                    },
                    {
                        targets: [1],
                        visible: false,
                        searchable: false
                    }
                ]
            });
        }
        const changeDateFormatTo = date => {
            if (!date) return ''; // Eğer tarih yoksa boş döner
            const onlyDate = date.split("T")[0];
            const [yy, mm, dd] = onlyDate.split("-");
            return `${dd}/${mm}/${yy}`;
        };
        function savePersonel() {
            $('#createModal span.text-danger').text('');
            $('#createModal .overlay').show();
            var formData = $('#PersonelEkleForm').serialize(); // Form verilerini serialize et
            $.ajax({
                url: '/Admin/Personel/EklePersonel', // Hedef URL
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#createModal').modal('hide');
                        reloadTable();
                        if (response.completeStatus) {
                            showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                        }
                        else {
                            showToast(response.message, 'Bilgi Mesajı', 'topRight', 3500, 'bg-warning', true);
                        }
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function editPersonel(id) {
            // event.preventDefault();
            $.ajax({
                url: `/Admin/Personel/GetPersonelById/${id}`,
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        const data = response.data;
                        $('#editModal #UpdatePersonelID').val(data.personelID);
                        $('#editModal #UpdateKimlikNo').val(data.kimlikNo);
                        $('#editModal #UpdateSicilNumarasi').val(data.sicilNumarasi);
                        $('#editModal #UpdateAd').val(data.ad);
                        $('#editModal #UpdateSoyad').val(data.soyad);
