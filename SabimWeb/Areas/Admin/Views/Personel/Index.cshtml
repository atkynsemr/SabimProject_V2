@model Sabim.Web.ViewModels.PersonelViewModel
@{
    ViewData["Title"] = "Personel";
}
@section StyleCss {
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/searchpanes/2.3.3/css/searchPanes.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/select/2.1.0/css/select.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/4.0.1/css/fixedHeader.bootstrap4.css">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
}

<!-- Personel Ekleme Modal Başlangıç-->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header primary">
                <h5 class="modal-title" id="createModalLabel">Personel Ekle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-header p-2 mb-3">
                    <ul class="nav nav-pills">
                        <li class="nav-item"><a class="nav-link active" href="#personelKisiselBilgileri" data-toggle="tab">Kişisel Bilgiler</a></li>
                        <li class="nav-item"><a class="nav-link" href="#timeline" data-toggle="tab">Timeline</a></li>
                        <li class="nav-item"><a class="nav-link" href="#settings" data-toggle="tab">Settings</a></li>
                    </ul>
                </div>
                <form id="PersonelEkleForm">
                    @Html.AntiForgeryToken()
                    <div class="tab-content">
                        <div class="active tab-pane" id="personelKisiselBilgileri">
                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label for="KimlikNo">T.C. Kimlik Numarası</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-id-card"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="kimlikNo" name="KimlikNo" asp-for="YeniPersonel.KimlikNo" placeholder="TC Kimlik Numarası Giriniz" maxlength="11" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                            <span asp-validation-for="YeniPersonel.KimlikNo" name="KimlikNo" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="SicilNumarasi">Sicil Numarası</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><strong>ab</strong></span>
                                            </div>
                                            <input type="text" class="form-control capitalize-input" id="sicilNumarasi" name="SicilNumarasi" asp-for="YeniPersonel.SicilNumarasi" placeholder="Sicil Numarasını Giriniz" minlength="5" maxlength="7" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" required />
                                            <span asp-validation-for="YeniPersonel.SicilNumarasi" name="SicilNumarasi" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="Ad">Personel Adı</label>
                                        <input type="text" class="form-control capitalize-input" id="ad" name="PersonelAdi" asp-for="YeniPersonel.Ad" placeholder="Personel Adı Giriniz" maxlength="30" required />
                                        <span asp-validation-for="YeniPersonel.Ad" name="Ad" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label for="Soyad">Personel Soyadı</label>
                                        <input type="text" class="form-control capitalize-input" id="soyad" name="PersonelSoyadi" asp-for="YeniPersonel.Soyad" placeholder="Personel Soyadı Giriniz" maxlength="25" required />
                                        <span asp-validation-for="YeniPersonel.Soyad" name="Soyad" class="text-danger"></span>
                                    </div>
                                    @await Component.InvokeAsync("_UnvanGenelComponent")
                                    @await Component.InvokeAsync("_KadroTuruGenelComponent")
                                    @await Component.InvokeAsync("_GorevlendirilmeTuruGenelComponent")
                                </div>
                                <div class="col">
                                    @await Component.InvokeAsync("_SehirListesiGenelComponent")
                                    <div id="personelEkleComponent">
                                        @await Component.InvokeAsync("_KurumGenelComponent", new { kurumTipiId = 1, sehirId = 1 })
                                    </div>
                                    <div class="form-group">
                                        <label for="Derece">Personel Derecesi</label>
                                        <input type="text" class="form-control" id="derece" name="Derece" asp-for="YeniPersonel.Derece" placeholder="Personel Derecesini Giriniz" maxlength="2" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                        <span asp-validation-for="YeniPersonel.Derece" name="Derece" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label for="Derece">Personel Kademesi</label>
                                        <input type="text" class="form-control" id="kademe" name="Kademe" asp-for="YeniPersonel.Kademe" placeholder="Personel Kademesini Giriniz" maxlength="1" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                        <span asp-validation-for="YeniPersonel.Kademe" name="Kademe" class="text-danger"></span>
                                    </div>
                                    @await Component.InvokeAsync("_CinsiyetListesiGenelComponent")
                                    @await Component.InvokeAsync("_KanGrubuGenelComponent")
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label for="dogumYeri">Doğum Yeri</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-map"></i></span>
                                            </div>
                                            <input type="text" class="form-control capitalize-input" id="dogumYeri" name="DogumYeri" asp-for="YeniPersonel.DogumYeri" placeholder="Doğum Yerini Giriniz" maxlength="35" />
                                            <span asp-validation-for="YeniPersonel.DogumYeri" name="DogumYeri" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Cep Telefonu</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="cepTelefonu" name="CepTelefonu" asp-for="YeniPersonel.CepTelefonu" placeholder="Cep Telefonu Giriniz" maxlength="11" />
                                            <span asp-validation-for="YeniPersonel.CepTelefonu" name="CepTelefonu" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Doğum Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="dogumTarihi" name="DogumTarihi" asp-for="YeniPersonel.DogumTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.DogumTarihi" name="DogumTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Mesleğe Giriş Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="meslegeGirisTarihi" name="MeslegeGirisTarihi" asp-for="YeniPersonel.MeslegeGirisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.MeslegeGirisTarihi" name="MeslegeGirisTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Burada Göreve Başlama Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="buradaGoreveBaslamaTarihi" name="BuradaGoreveBaslamaTarihi" asp-for="YeniPersonel.BuradaGoreveBaslamaTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.BuradaGoreveBaslamaTarihi" name="BuradaGoreveBaslamaTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Birinci Sınıfa Ayrılma Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="birinciSinifaAyrilmaTarihi" name="BirinciSinifaAyrilmaTarihi" asp-for="YeniPersonel.BirinciSinifaAyrilmaTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.BirinciSinifaAyrilmaTarihi" name="DogumTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" id="DurumId" name="DurumId" asp-for="YeniPersonel.DurumId" value="1" />
                            </div>
                        </div>
                        <!-- /.tab-pane -->
                        <div class="tab-pane" id="timeline">
                            <!-- The timeline -->
                            <div class="timeline timeline-inverse">
                                <!-- timeline time label -->
                                <div class="time-label">
                                    <span class="bg-danger">
                                        10 Feb. 2014
                                    </span>
                                </div>
                                <!-- /.timeline-label -->
                                <!-- timeline item -->
                                <div>
                                    <i class="fas fa-envelope bg-primary"></i>

                                    <div class="timeline-item">
                                        <span class="time"><i class="far fa-clock"></i> 12:05</span>

                                        <h3 class="timeline-header"><a href="#">Support Team</a> sent you an email</h3>

                                        <div class="timeline-body">
                                            Etsy doostang zoodles disqus groupon greplin oooj voxy zoodles,
                                            weebly ning heekya handango imeem plugg dopplr jibjab, movity
                                            jajah plickers sifteo edmodo ifttt zimbra. Babblely odeo kaboodle
                                            quora plaxo ideeli hulu weebly balihoo...
                                        </div>
                                        <div class="timeline-footer">
                                            <a href="#" class="btn btn-primary btn-sm">Read more</a>
                                            <a href="#" class="btn btn-danger btn-sm">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                <!-- END timeline item -->
                                <!-- timeline item -->
                                <div>
                                    <i class="fas fa-user bg-info"></i>

                                    <div class="timeline-item">
                                        <span class="time"><i class="far fa-clock"></i> 5 mins ago</span>

                                        <h3 class="timeline-header border-0">
                                            <a href="#">Sarah Young</a> accepted your friend request
                                        </h3>
                                    </div>
                                </div>
                                <!-- END timeline item -->
                                <!-- timeline item -->
                                <div>
                                    <i class="fas fa-comments bg-warning"></i>

                                    <div class="timeline-item">
                                        <span class="time"><i class="far fa-clock"></i> 27 mins ago</span>

                                        <h3 class="timeline-header"><a href="#">Jay White</a> commented on your post</h3>

                                        <div class="timeline-body">
                                            Take me to your leader!
                                            Switzerland is small and neutral!
                                            We are more like Germany, ambitious and misunderstood!
                                        </div>
                                        <div class="timeline-footer">
                                            <a href="#" class="btn btn-warning btn-flat btn-sm">View comment</a>
                                        </div>
                                    </div>
                                </div>
                                <!-- END timeline item -->
                                <!-- timeline time label -->
                                <div class="time-label">
                                    <span class="bg-success">
                                        3 Jan. 2014
                                    </span>
                                </div>
                                <!-- /.timeline-label -->
                                <!-- timeline item -->
                                <div>
                                    <i class="fas fa-camera bg-purple"></i>

                                    <div class="timeline-item">
                                        <span class="time"><i class="far fa-clock"></i> 2 days ago</span>

                                        <h3 class="timeline-header"><a href="#">Mina Lee</a> uploaded new photos</h3>

                                        <div class="timeline-body">
                                            <img src="https://placehold.it/150x100" alt="...">
                                            <img src="https://placehold.it/150x100" alt="...">
                                            <img src="https://placehold.it/150x100" alt="...">
                                            <img src="https://placehold.it/150x100" alt="...">
                                        </div>
                                    </div>
                                </div>
                                <!-- END timeline item -->
                                <div>
                                    <i class="far fa-clock bg-gray"></i>
                                </div>
                            </div>
                        </div>
                        <!-- /.tab-pane -->

                        <div class="tab-pane" id="settings">
                            <form class="form-horizontal">
                                <div class="form-group row">
                                    <label for="inputName" class="col-sm-2 col-form-label">Name</label>
                                    <div class="col-sm-10">
                                        <input type="email" class="form-control" id="inputName" placeholder="Name">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="inputEmail" class="col-sm-2 col-form-label">Email</label>
                                    <div class="col-sm-10">
                                        <input type="email" class="form-control" id="inputEmail" placeholder="Email">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="inputName2" class="col-sm-2 col-form-label">Name</label>
                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" id="inputName2" placeholder="Name">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="inputExperience" class="col-sm-2 col-form-label">Experience</label>
                                    <div class="col-sm-10">
                                        <textarea class="form-control" id="inputExperience" placeholder="Experience"></textarea>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="inputSkills" class="col-sm-2 col-form-label">Skills</label>
                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" id="inputSkills" placeholder="Skills">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="offset-sm-2 col-sm-10">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox"> I agree to the <a href="#">terms and conditions</a>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="offset-sm-2 col-sm-10">
                                        <button type="submit" class="btn btn-danger">Submit</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <!-- /.tab-pane -->
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="KaydetPersonelButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel Ekleme Modal Bitiş-->
<!-- Modal -->
<div class="modal fade" id="unvanBazlıVerilerModal" tabindex="-1" role="dialog" aria-labelledby="unvanBazlıVerilerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header font-weight-bolder text-primary">
                <h5 class="modal-title" id="unvanBazlıVerilerModalLabel">Personel İstatiksel Veriler</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalContent">
                <p id="loadingMessage" class="font-weight-bolder">Veriler yükleniyor, lütfen bekleyin...</p>
                <!-- Partial view içeriği burada dinamik olarak yerleştirilecek -->
            </div>
            <div class="modal-footer">
                <button type="button" id="unvanBazlıVerilerCloseModal" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
<!--./ Modal -->
<!-- Personel Safahat Modal Başlangıç-->
<div class="modal fade" id="auditTrailModal" tabindex="-1" role="dialog" aria-labelledby="auditTrailModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary">
                <h5 class="modal-title" id="auditTrailModalLabel">Safahat Bilgileri</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--Veriler Yüklenecek-->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel Safahat Modal Başlangıç-->
<div class="card">
    <div class="d-flex card-header">
        <button type="button" class="btn btn-outline-dark btn-flat my-2" data-toggle="modal" data-target="#unvanBazlıVerilerModal"><i class="fas fa-chart-bar mr-1"></i> Ünvan İstatistikleri</button>
        @Html.Raw(IconHelper.CreateButton("btn btn-outline-primary btn-flat my-2 ml-auto", "Yeni Personel", IconHelper.GetAddIcon(), "Yeni Personel Ekle", "createModal"))
    </div>
    <div class="card-body mt-2">
        <div id="PersonelTablosu">
            <table id="example" class="table table-striped table-bordered table-hover display text-center mt-3" style="width:100% !important">
                <thead>
                    <tr>
                        <th>Ünvan Önceliği</th>
                        <th>Ad ve Soyad</th>
                        <th class="text-center">Sicil No</th>
                        <th>T.C Kimlik No</th>
                        <th>Unvan</th>
                        <th>Derece ve Kademe</th>
                        <th>Doğum Yeri ve Tarihi</th>
                        <th>Cinsiyet</th>
                        <th>Kan Grubu</th>
                        <th>Cep Telefonu</th>
                        <th>Kadrosunun Bulunduğu Kurum</th>
                        <th>Kadro Türü</th>
                        <th>Çalışma Durumu</th>
                        <th>Görevlendirilme Türü</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                @await Component.InvokeAsync("_PersonelComponent")
                <tfoot>
                    <tr>
                        <th>Ünvan Önceliği</th>
                        <th>Ad ve Soyad</th>
                        <th class="text-center">Sicil No</th>
                        <th>T.C Kimlik No</th>
                        <th>Unvan</th>
                        <th>Derece ve Kademe</th>
                        <th>Doğum Yeri ve Tarihi</th>
                        <th>Cinsiyet</th>
                        <th>Kan Grubu</th>
                        <th>Cep Telefonu</th>
                        <th>Kadrosunun Bulunduğu Kurum</th>
                        <th>Kadro Türü</th>
                        <th>Çalışma Durumu</th>
                        <th>Görevlendirilme Türü</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/dataTables.searchPanes.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/searchPanes.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/dataTables.colReorder.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/colReorder.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/dataTables.fixedHeader.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/fixedHeader.bootstrap4.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.8/dist/sweetalert2.all.min.js"></script>
    <!-- Toastr -->
    <script src="/AdminTemplate/dist/js/toastr.min.js"></script>
    <!-- Custom Toastr JS-->
    <script src="/AdminTemplate/dist/js/customize/ToastCustom.js"></script>
    <!-- Custom Capitalize JS-->
    <script src="/AdminTemplate/dist/js/customize/CapitalizeCustom.js"></script>
    <!-- Custom SwalAert JS-->
    <script src="/AdminTemplate/dist/js/customize/SwalAlertCustom.js"></script>
    <!-- InputMask -->
    <script src="/AdminTemplate/plugins/jquery/jquery.inputmask.min.js"></script>
    <script>
        $(document).ready(function() {
            initDataTable();
            $(".modal").on("hidden.bs.modal", function() {
                $('.modal').each(function() {
                    let modal = $(this);
                    let form = modal.find('form');
                    // Eğer form varsa, formu sıfırla
                    if (form.length) {
                        form[0].reset();
                    }
                    // Hata mesajlarını temizle
                    modal.find('span.text-danger').text('');
                });
                // Overlay (arka plan) elemanını gizle
                $('.overlay').hide();
            });
            $('[data-widget="pushmenu"]').on('click', function() {
                setTimeout(function() {
                    var table = $('#example').DataTable();
                    table.columns.adjust().draw(); // Sütunları yeniden boyutlandır ve yeniden çiz
                }, 300); // Animasyon tamamlandıktan sonra
            });
            $(document).on('click', '.btn-showinfo', function(event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    showInfoPersonel(id);
                }
            });
            $('#sehirler').change(function() {
                var selectedSehirId = $(this).val();
                changeKurum(selectedSehirId);
            });
            $('#datemask').inputmask('dd/mm/yyyy', { 'placeholder': 'dd/mm/yyyy' });
            $('[data-mask]').inputmask();
        });
        function initDataTable() {
            $('#example').DataTable({
                "scrollX": true,
                "fixedHeader": true,
                "responsive": false,
                "lengthChange": false,
                "autoWidth": false,
                "lengthChange": true,
                "pageLength": 25,
                "order": [[0, 'asc'], [2, 'asc']],
                "language": {
                    "searchPanes": {
                        "emptyPanes": 'Filtreleme Paneli Bulunamadı',
                        "title": {
                            _: 'Seçili Alan - %d',
                            0: ''
                        },
                        "collapseMessage": 'Tümünü Kapat',
                        "showMessage": 'Hepsini Göster',
                        "clearMessage": 'Hepsini Temizle'
                    },
                    "sProcessing": "İşleniyor...",
                    "sLengthMenu": "_MENU_",
                    "sZeroRecords": "Eşleşen Kayıt Bulunmadı",
                    "sInfo": "Toplam _TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "sInfoEmpty": "Kayıt Yok",
                    "emptyTable": "Tabloda veri bulunmamaktadır",
                    "sInfoFiltered": "(toplam _MAX_ kayıttan filtrelendi)",
                    "sSearch": "",
                    "searchPlaceholder": 'Arama Yapınız...',
                    "oPaginate": {
                        "sFirst": "İlk",
                        "sPrevious": "Önceki",
                        "sNext": "Sonraki",
                        "sLast": "Son"
                    }
                },
                colReorder: true,
                layout: {
                    topStart:
                    {
                        buttons:
                            [
                                {
                                    extend: 'searchPanes',
                                    text: '<i class="fa fa-filter mr-1"></i>Filtreleme Paneli',
                                    config: {
                                        cascadePanes: true,
                                        layout: 'columns-2',
                                        orderable: false,
                                        initCollapsed: true
                                    }
                                },
                                {
                                    extend: 'collection',
                                    text: '<i class="fas fa-upload mr-1"></i> Aktar',
                                    buttons:
                                        [
                                            {
                                                extend: 'excel',
                                                text: '<i class="fas fa-file-excel mr-1"></i> Excel',
                                                exportOptions: {
                                                    columns: ':visible:not(:eq(14))'
                                                }
                                            },
                                            {
                                                extend: 'pdf',
                                                text: '<i class="fas fa-file-pdf mr-1"></i> PDF',
                                                exportOptions: {
                                                    columns: ':visible:not(:eq(14))'
                                                },
                                                customize: function(doc) {
                                                    // Tablonun başlıklarını ve içeriğini ortala
                                                    doc.styles.tableHeader.alignment = 'center';
                                                    doc.content[1].table.body.forEach(function(row) {
                                                        row.forEach(function(cell) {
                                                            cell.alignment = 'center';
                                                        });
                                                    });
                                                    doc.content[1].table.widths = new Array(doc.content[1].table.body[0].length).fill('*');
                                                }
                                            },
                                            {
                                                extend: 'print',
                                                text: '<i class="fas fa-print mr-1"></i> Yazdır',
                                                exportOptions: {
                                                    columns: ':visible:not(:eq(14))'
                                                }
                                            }
                                        ]
                                },
                                {
                                    extend: 'colvis',
                                    columns: function(idx, data, node) {
                                        return [0].indexOf(idx) === -1;
                                    },
                                    text: '<i class="fas fa-columns mr-1"></i> Sütun Görünürlüğü'
                                }
                            ]
                    }
                },
                columnDefs: [
                    {
                        searchPanes: {
                            show: true,
                            dtOpts: {
                                select: {
                                    style: 'multi'
                                },
                                searching: true,
                            }
                        },
                        targets: [4, 7, 10, 11, 12]
                    },
                    {
                        searchPanes: {
                            show: false
                        },
                        targets: '_all'
                    },
                    {
                        targets: [7, 8, 9],
                        visible: false
                    },
                    {
                        targets: [0],
                        visible: false,
                        searchable: false
                    }
                ]



            });
        }
        function showInfoPersonel(id) {
            $.ajax({
                url: `/Admin/Personel/GetirSafahatBilgi/${id}`,
                type: 'GET',
                success: function(response) {
                    $("#auditTrailModal").find(".modal-body").html(response);
                    $('#auditTrailModal').modal('show');
                },
                error: function() {
                    showToast('Safahat bilgileri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                }
            });
        }
        function reloadComponent(componentSelector, url) {
            $(componentSelector).load(url, function(response, status, xhr) {
                if (status === "error") {
                    setTimeout(function() {
                        window.location.reload(); // Sayfayı yeniden yükle
                    }, 1500);
                }
            });
        }
        function changeKurum(id) {
            var url = `/Admin/Personel/GetirKurumlar/${id}`;
            reloadComponent("#createModal #personelEkleComponent", url);
        }
        function reloadTable() {
            // Eski tabloyu kaldır
            if ($.fn.DataTable.isDataTable('#example')) {
                $('#example').DataTable().destroy();
                $('#example').empty(); // DOM'u temizle
            }
            // Tabloyu yeniden yükle
            $('#PersonelTablosu').load('/Admin/Personel #PersonelTablosu', function(response, status, xhr) {
                if (status === "success") {
                    initDataTable(); // DataTable başlat
                } else if (status === "error") {
                    showToast("Tablo yüklenemedi. Lütfen sayfayı yenileyin.", "Hata", "topRight", 3500, "bg-danger", true);
                }
            });
        }
        function handleError(xhr) {
            $('.modal .overlay').hide();
            if (xhr.responseJSON && xhr.responseJSON.errors) {
                for (let key in xhr.responseJSON.errors) {
                    let errorElement = $(`[name='${key}']`).next('.text-danger');
                    errorElement.text(xhr.responseJSON.errors[key][0]);
                }
            }
            else {
                $('.modal').modal('hide'); // Tüm açık modalları kapatır
                showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
            }
        }
    </script>
}

