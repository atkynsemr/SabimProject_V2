                            const selectedValues = data.calisilanKatiplerIds.map(String); // Choices.js string değerler bekler
                            if (window.updatePersonelChoices) {
                                window.updatePersonelChoices.removeActiveItems(); // Önce mevcut seçimleri temizle
                                window.updatePersonelChoices.setChoiceByValue(selectedValues);
