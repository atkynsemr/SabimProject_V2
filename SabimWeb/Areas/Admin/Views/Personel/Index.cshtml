                        $('#editModal #updateDurumlar option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.durumId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #UpdateDerece').val(data.derece);
                        $('#editModal #UpdateKademe').val(data.kademe);
                        $('#editModal #UpdateDogumYeri').val(data.dogumYeri);
                        $('#editModal #UpdateCepTelefonu').val(data.cepTelefonu);
                        $('#editModal #UpdateDogumTarihi').val(changeDateFormatTo(data.dogumTarihi));
                        $('#editModal #UpdateMeslegeGirisTarihi').val(changeDateFormatTo(data.meslegeGirisTarihi));
                        $('#editModal #UpdateBuradaGoreveBaslamaTarihi').val(changeDateFormatTo(data.buradaGoreveBaslamaTarihi));
                        $('#editModal #UpdateBirinciSinifaAyrilmaTarihi').val(changeDateFormatTo(data.birinciSinifaAyrilmaTarihi));
