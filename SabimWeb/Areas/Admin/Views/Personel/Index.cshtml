                                    </div>
                                    <input type="text" class="form-control" id="UpdateKimlikNo" name="KimlikNo" asp-for="GuncellePersonel.KimlikNo" placeholder="TC Kimlik Numarası Giriniz" maxlength="11" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                    <span asp-validation-for="GuncellePersonel.KimlikNo" name="KimlikNo" class="col-sm-12 text-danger"></span>
                                </div>
