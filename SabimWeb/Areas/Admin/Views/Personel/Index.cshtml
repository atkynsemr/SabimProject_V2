                        });
                        $('#editModal #updateSehirler option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.sehirId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        changeKurum(data.kurumId, data.sehirId, "update");
                        $('#editModal #updateCinsiyetler option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.cinsiyetId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #updateKanGruplari option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.kanGrubuId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #updateCalismaDurumlari option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.calismaDurumuId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
