                                    <span asp-validation-for="GuncellePersonel.DogumYeri" name="DogumYeri" class="col-sm-12 text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label>Cep Telefonu</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    </div>
                                    <input type="text" class="form-control" id="UpdateCepTelefonu" name="CepTelefonu" asp-for="GuncellePersonel.CepTelefonu" placeholder="Cep Telefonu Giriniz" maxlength="11" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                    <span asp-validation-for="GuncellePersonel.CepTelefonu" name="CepTelefonu" class="col-sm-12 text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Doğum Tarihi</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                    </div>
                                    <input type="text" class="form-control" id="UpdateDogumTarihi" name="DogumTarihi" asp-for="GuncellePersonel.DogumTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                    <span asp-validation-for="GuncellePersonel.DogumTarihi" name="DogumTarihi" class="col-sm-12 text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Mesleğe Giriş Tarihi</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                    </div>
                                    <input type="text" class="form-control" id="UpdateMeslegeGirisTarihi" name="MeslegeGirisTarihi" asp-for="GuncellePersonel.MeslegeGirisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                    <span asp-validation-for="GuncellePersonel.MeslegeGirisTarihi" name="MeslegeGirisTarihi" class="col-sm-12 text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Burada Göreve Başlama Tarihi</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                    </div>
                                    <input type="text" class="form-control" id="UpdateBuradaGoreveBaslamaTarihi" name="BuradaGoreveBaslamaTarihi" asp-for="GuncellePersonel.BuradaGoreveBaslamaTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                    <span asp-validation-for="GuncellePersonel.BuradaGoreveBaslamaTarihi" name="BuradaGoreveBaslamaTarihi" class="col-sm-12 text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group">
