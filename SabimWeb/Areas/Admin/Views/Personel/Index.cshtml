@model Sabim.Web.ViewModels.PersonelViewModel
@{
    ViewData["Title"] = "Personel";
}
@section StyleCss {
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/searchpanes/2.3.3/css/searchPanes.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/select/2.1.0/css/select.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/4.0.1/css/fixedHeader.bootstrap4.css">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/choices.min.css">
}

<!-- Personel Ekleme Modal Başlangıç-->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header primary">
                <h5 class="modal-title" id="createModalLabel">Personel Ekle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-header p-2 mb-3">
                    <ul class="nav nav-pills">
                        <li class="nav-item"><a class="nav-link active" href="#personelKisiselBilgileri" data-toggle="tab">Kişisel Bilgiler</a></li>
                        <li class="nav-item"><a class="nav-link" href="#personelKullaniciBilgileri" data-toggle="tab">Kullanıcı Bilgileri</a></li>
                    </ul>
                </div>
                <form id="PersonelEkleForm">
                    @Html.AntiForgeryToken()
                    <div class="tab-content">
                        <div class="active tab-pane" id="personelKisiselBilgileri">
                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label for="KimlikNo">T.C. Kimlik Numarası</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-id-card"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateKimlikNo" name="KimlikNo" asp-for="YeniPersonel.KimlikNo" placeholder="TC Kimlik Numarası Giriniz" maxlength="11" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                            <span asp-validation-for="YeniPersonel.KimlikNo" name="KimlikNo" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="SicilNumarasi">Sicil Numarası</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><strong>ab</strong></span>
                                            </div>
                                            <input type="text" class="form-control capitalize-input" id="CreateSicilNumarasi" name="SicilNumarasi" asp-for="YeniPersonel.SicilNumarasi" placeholder="Sicil Numarasını Giriniz" minlength="5" maxlength="7" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" required />
                                            <span asp-validation-for="YeniPersonel.SicilNumarasi" name="SicilNumarasi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="Ad">Personel Adı</label>
                                        <input type="text" class="form-control capitalize-input" id="CreateAd" name="Ad" asp-for="YeniPersonel.Ad" placeholder="Personel Adı Giriniz" maxlength="30" required />
                                        <span asp-validation-for="YeniPersonel.Ad" name="Ad" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label for="Soyad">Personel Soyadı</label>
                                        <input type="text" class="form-control capitalize-input" id="CreateSoyad" name="Soyad" asp-for="YeniPersonel.Soyad" placeholder="Personel Soyadı Giriniz" maxlength="25" required />
                                        <span asp-validation-for="YeniPersonel.Soyad" name="Soyad" class="text-danger"></span>
                                    </div>
                                    @await Component.InvokeAsync("_UnvanGenelComponent", new { deger = "create" })
                                    <div id="katipler_content">
                                    @await Component.InvokeAsync("_PersonelListesiComponent", new { deger = "create" })
                                    </div>
                                    @await Component.InvokeAsync("_KadroTuruGenelComponent", new { deger = "create" })
                                </div>
                                <div class="col">
                                    @await Component.InvokeAsync("_GorevlendirilmeTuruGenelComponent", new { deger = "create" })
                                    @await Component.InvokeAsync("_SehirListesiGenelComponent", new { deger = "create", selectedSehirId = 55 })
                                    <div id="personelEkleComponent">
                                        @await Component.InvokeAsync("_KurumGenelComponent", new { deger = "create", selectedKurumId = 784, kurumTipiId = 1, sehirId = 55 })
                                    </div>
                                    <div class="form-group">
                                        <label for="Derece">Personel Derecesi</label>
                                        <input type="text" class="form-control" id="CreateDerece" name="Derece" asp-for="YeniPersonel.Derece" placeholder="Personel Derecesini Giriniz" maxlength="2" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                        <span asp-validation-for="YeniPersonel.Derece" name="Derece" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label for="Derece">Personel Kademesi</label>
                                        <input type="text" class="form-control" id="CreateKademe" name="Kademe" asp-for="YeniPersonel.Kademe" placeholder="Personel Kademesini Giriniz" maxlength="1" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                        <span asp-validation-for="YeniPersonel.Kademe" name="Kademe" class="text-danger"></span>
                                    </div>
                                    @await Component.InvokeAsync("_CinsiyetListesiGenelComponent", new { deger = "create" })
                                    @await Component.InvokeAsync("_KanGrubuGenelComponent", new { deger = "create" })
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label for="dogumYeri">Doğum Yeri</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-map"></i></span>
                                            </div>
                                            <input type="text" class="form-control capitalize-input" id="CreateDogumYeri" name="DogumYeri" asp-for="YeniPersonel.DogumYeri" placeholder="Doğum Yerini Giriniz" maxlength="35" />
                                            <span asp-validation-for="YeniPersonel.DogumYeri" name="DogumYeri" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Cep Telefonu</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateCepTelefonu" name="CepTelefonu" asp-for="YeniPersonel.CepTelefonu" placeholder="Cep Telefonu Giriniz" maxlength="11" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                            <span asp-validation-for="YeniPersonel.CepTelefonu" name="CepTelefonu" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Doğum Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateDogumTarihi" name="DogumTarihi" asp-for="YeniPersonel.DogumTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.DogumTarihi" name="DogumTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Mesleğe Giriş Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateMeslegeGirisTarihi" name="MeslegeGirisTarihi" asp-for="YeniPersonel.MeslegeGirisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.MeslegeGirisTarihi" name="MeslegeGirisTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Burada Göreve Başlama Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateBuradaGoreveBaslamaTarihi" name="BuradaGoreveBaslamaTarihi" asp-for="YeniPersonel.BuradaGoreveBaslamaTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.BuradaGoreveBaslamaTarihi" name="BuradaGoreveBaslamaTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Birinci Sınıfa Ayrılma Tarihi</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateBirinciSinifaAyrilmaTarihi" name="BirinciSinifaAyrilmaTarihi" asp-for="YeniPersonel.BirinciSinifaAyrilmaTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                                            <span asp-validation-for="YeniPersonel.BirinciSinifaAyrilmaTarihi" name="DogumTarihi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="dogumYeri">Araç Plakası</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-car"></i></span>
                                            </div>
                                            <input type="text" class="form-control text-capitalize" id="CreateAracPlakasi" name="AracPlakasi" asp-for="YeniPersonel.AracPlakasi" placeholder="Araç Plakası Giriniz" maxlength="11" />
                                            <span asp-validation-for="YeniPersonel.AracPlakasi" name="AracPlakasi" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" id="CreateDurumId" name="DurumId" asp-for="YeniPersonel.DurumId" value="1" />
                                <input type="hidden" id="CreateCalismaDurumuId" name="CalismaDurumuId" asp-for="YeniPersonel.CalismaDurumuId" value="1" />
                            </div>
                        </div>
                        <!-- /.tab-pane -->
                        <div class="tab-pane" id="personelKullaniciBilgileri">
                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label for="UserName">Kullanıcı Adı</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-user"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="CreateUserName" name="UserName" asp-for="YeniKullanici.UserName" placeholder="Kullanıcı Adını Giriniz" maxlength="20" required />
                                            <span asp-validation-for="YeniKullanici.UserName" name="UserName" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="Email">Email</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                            </div>
                                            <input type="email" class="form-control" id="CreateEmail" name="Email" asp-for="YeniKullanici.Email" placeholder="Email Adresini Giriniz" maxlength="35" required />
                                            <span asp-validation-for="YeniKullanici.Email" name="Email" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="Password">Şifre</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                            </div>
                                            <input type="password" class="form-control" id="CreatePassword" name="Password" asp-for="YeniKullanici.Password" placeholder="Şifre Giriniz" maxlength="15" required />
                                            <span asp-validation-for="YeniKullanici.Password" name="Password" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ConfirmPassword">Şifre(Tekrar)</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                            </div>
                                            <input type="password" class="form-control" id="CreateConfirmPassword" name="ConfirmPassword" asp-for="YeniKullanici.ConfirmPassword" placeholder="Şifre(Tekrar) Giriniz" maxlength="15" required />
                                            <span asp-validation-for="YeniKullanici.ConfirmPassword" name="ConfirmPassword" class="col-sm-12 text-danger"></span>
                                        </div>
                                    </div>
                                    @await Component.InvokeAsync("_AppRoleGenelComponent", new { deger = "create" })
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="KaydetPersonelButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel Ekleme Modal Bitiş-->
<!-- Personel Düzenleme Modal Başlangıç-->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
            <div class="overlay">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header warning">
                <h5 class="modal-title" id="editModalLabel">Personel Düzenle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
