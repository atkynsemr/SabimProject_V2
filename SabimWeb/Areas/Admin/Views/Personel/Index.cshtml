                },
                error: function () {
                    showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu!', 'error', 3500, true, true);
                }
            });
        }
        function saveUpdatedPersonel() {
            var formData = $('#PersonelGuncelleForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/Personel/GuncellePersonel',
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#editModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function deletePersonel() {
            $('#deleteModal .overlay').show();
            var formData = $('#PersonelSilForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/Personel/SilPersonel', // Silme işlemi için endpoint
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#deleteModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        $('#deleteModal').modal('hide');
                        showToast(response.message, 'Hata Mesajı', 'topRight', 3500, 'bg-danger', true);
                    }
                },
                error: function (xhr) {
                    handleError(xhr); // Hata durumunu yönet
                }
            });
        }
        function showInfoPersonel(id) {
            $.ajax({
                url: `/Admin/Personel/GetirSafahatBilgi/${id}`,
                type: 'GET',
                success: function (response) {
                    $("#auditTrailModal").find(".modal-body").html(response);
                    $('#auditTrailModal').modal('show');
                },
                error: function () {
                    showToast('Safahat bilgileri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                }
            });
        }
        function reloadComponent(componentSelector, url) {
            $(componentSelector).load(url, function (response, status, xhr) {
                if (status === "error") {
                    setTimeout(function () {
                        window.location.reload(); // Sayfayı yeniden yükle
                    }, 1500);
                }
            });
        }
        function changeKurum(selectedKurumId, id, deger) {
            // URL'yi doğru şekilde oluşturma
            var url = `/Admin/Personel/GetirKurumlar?deger=${deger}&selectedKurumId=${selectedKurumId}&id=${id}`;
            if (deger === "create") {
                reloadComponent("#createModal #personelEkleComponent", url);
            }
            else if (deger === "update") {
                reloadComponent("#editModal #personelGuncelleComponent", url);
            }
            else {
                console.warn("Geçersiz işlem türü (deger):", deger);
            }
        }
        function reloadTable() {
            // Eski tabloyu kaldır
            if ($.fn.DataTable.isDataTable('#example')) {
                $('#example').DataTable().destroy();
                $('#example').empty(); // DOM'u temizle
            }
            // Tabloyu yeniden yükle
            $('#PersonelTablosu').load('/Admin/Personel #PersonelTablosu', function (response, status, xhr) {
                if (status === "success") {
                    initDataTable(); // DataTable başlat
                } else if (status === "error") {
                    showToast("Tablo yüklenemedi. Lütfen sayfayı yenileyin.", "Hata", "topRight", 3500, "bg-danger", true);
                }
            });
        }
        function handleError(xhr) {
            $('.modal .overlay').hide();
            if (xhr.responseJSON && xhr.responseJSON.errors) {
                for (let key in xhr.responseJSON.errors) {
                    let errorElement = $(`[name='${key}']`).next('.text-danger');
                    errorElement.text(xhr.responseJSON.errors[key][0]);
                }
            }
            else {
                $('.modal').modal('hide'); // Tüm açık modalları kapatır
                showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
            }
        }
        document.addEventListener('DOMContentLoaded', function () {
            const sicilInput = document.getElementById('CreateSicilNumarasi');
            const userNameInput = document.getElementById('CreateUserName');
            const emailInput = document.getElementById('CreateEmail');
            const confirmPassword = document.getElementById('CreateConfirmPassword');
            const password = document.getElementById('CreatePassword');
            // Sicil Numarası alanından focus çıkışı olduğunda diğer alanları doldur
            sicilInput.addEventListener('blur', function () {
                const sicilValue = sicilInput.value.trim();
                // Sicil numarası doluysa
                if (sicilValue) {
                    userNameInput.value = sicilValue;
                    confirmPassword.value = sicilValue;
                    password.value = sicilValue;
                    emailInput.value = `ab${sicilValue}@@adalet.gov.tr`;
                } else {
                    // Sicil numarası boşsa diğer alanları temizle
                    userNameInput.value = '';
                    confirmPassword.value = '';
                    password.value = '';
                    emailInput.value = '';
                }
            });
        });
        function toggleCreateKatiplerContent() {
            var selectedValue = $('#createUnvanlar').val();
            if (selectedValue == '1' || selectedValue == '2' || selectedValue == '5') {
                $('#katipler_content').show();
            } else {
                $('#katipler_content').hide();
            }
        }
        function toggleUpdateKatiplerContent() {
            var selectedValue = $('#updateUnvanlar').val();
            if (selectedValue == '1' || selectedValue == '2' || selectedValue == '5') {
                $('#update_katipler_content').show();
            } else {
                $('#update_katipler_content').hide();
            }
        }
    </script>
}



