                                <span asp-validation-for="GuncellePersonel.Ad" name="Ad" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="Soyad">Personel Soyadı</label>
                                <input type="text" class="form-control capitalize-input" id="UpdateSoyad" name="Soyad" asp-for="GuncellePersonel.Soyad" placeholder="Personel Soyadı Giriniz" maxlength="25" required />
                                <span asp-validation-for="GuncellePersonel.Soyad" name="Soyad" class="text-danger"></span>
                            </div>
                            @await Component.InvokeAsync("_UnvanGenelComponent", new { deger = "update" })
                            <div id="update_katipler_content">
                                @await Component.InvokeAsync("_PersonelListesiComponent", new { deger = "update" })
                            </div>
                            @await Component.InvokeAsync("_KadroTuruGenelComponent", new { deger = "update" })
                            @await Component.InvokeAsync("_GorevlendirilmeTuruGenelComponent", new { deger = "update" })
                            @await Component.InvokeAsync("_CalismaDurumuGenelComponent", new { deger = "update" })
                        </div>
                        <div class="col">
                            @await Component.InvokeAsync("_SehirListesiGenelComponent", new { deger = "update" })
                            <div id="personelGuncelleComponent">
                                @await Component.InvokeAsync("_KurumGenelComponent", new { kurumTipiId = 1, sehirId = 1 })
                            </div>
                            <div class="form-group">
                                <label for="Derece">Personel Derecesi</label>
                                <input type="text" class="form-control" id="UpdateDerece" name="Derece" asp-for="GuncellePersonel.Derece" placeholder="Personel Derecesini Giriniz" maxlength="2" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                <span asp-validation-for="GuncellePersonel.Derece" name="Derece" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="Derece">Personel Kademesi</label>
                                <input type="text" class="form-control" id="UpdateKademe" name="Kademe" asp-for="GuncellePersonel.Kademe" placeholder="Personel Kademesini Giriniz" maxlength="1" onkeypress="return event.charCode >= 48 && event.charCode <= 57;" />
                                <span asp-validation-for="GuncellePersonel.Kademe" name="Kademe" class="text-danger"></span>
                            </div>
                            @await Component.InvokeAsync("_CinsiyetListesiGenelComponent", new { deger = "update" })
                            @await Component.InvokeAsync("_KanGrubuGenelComponent", new { deger = "update" })
                            <div class="form-group">
