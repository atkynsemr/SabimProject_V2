@using Sabim.Domain.DTOs.MalzemeMarkaDtos
@model List<ResultMalzemeMarkaDto>
<tbody class="text-heading">
    @foreach (var malzemeMarka in Model)
    {
        <tr>
            <td>@malzemeMarka.MarkaAdi</td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.GetStatusNameIcon(malzemeMarka.DurumAdi))
                    <span class="badge badge-lg @BadgeHelper.GetBadgeClass(malzemeMarka.DurumId)"> @malzemeMarka.DurumAdi</span>
                </div>
            </td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-showinfo", "", IconHelper.GetInfoIcon(), "Göster", "showInfoMalzemeMarka", malzemeMarka.MalzemeMarkaID.ToString()))
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-edit", "", IconHelper.GetEditIcon(), "Düzenle", "editMalzemeMarka", malzemeMarka.MalzemeMarkaID.ToString()))
                    @Html.Raw(IconHelper.CreateLink("btn btn-icon btn-delete", "", IconHelper.GetDeleteIcon(), "Sil", "deleteMalzemeMarka", malzemeMarka.MalzemeMarkaID.ToString()))
                </div>
            </td>
        </tr>
    }
</tbody>