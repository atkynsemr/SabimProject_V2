@using Sabim.Domain.DTOs.BirimDtos
@model List<ResultBirimWithKisimCountDto>
<tbody class="text-heading">
    @foreach (var birim in Model)
    {
        <tr>
            <td>@birim.BolumAdi</td>
            <td>@birim.BirimAdi</td>
            <td class="text-center"><i class="fas fa-building mr-1 text-secondary"></i>@birim.KisimSayisi</td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.GetStatusNameIcon(birim.DurumAdi))
                    <span class="badge badge-lg @BadgeHelper.GetBadgeClass(birim.DurumId)"> @birim.DurumAdi</span>
                </div>
            </td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-showinfo", "", IconHelper.GetInfoIcon(), "Göster", "showInfoBirim", birim.BirimID.ToString()))
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-edit", "", IconHelper.GetEditIcon(), "Düzenle", "editBirim", birim.BirimID.ToString()))
                    @Html.Raw(IconHelper.CreateLink("btn btn-icon btn-delete", "", IconHelper.GetDeleteIcon(), "Sil", "deleteBirim", birim.BirimID.ToString()))
                </div>
            </td>
        </tr>
    }
</tbody>


