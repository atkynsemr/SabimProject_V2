@using Sabim.Domain.DTOs.KabinetBazliBolumDtos
@model List<ResultKabinetBazliBolumWithKisimCountDto>
<tbody class="text-heading">
    @foreach (var kabinet in Model)
    {
        <tr>
            <td>@kabinet.KabinetBazliBolumAdi</td>
            <td class="text-center"><i class="fas fa-building mr-1 text-secondary"></i>@kabinet.KisimSayisi</td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.GetStatusNameIcon(kabinet.DurumAdi))
                    <span class="badge badge-lg @BadgeHelper.GetBadgeClass(kabinet.DurumId)"> @kabinet.DurumAdi</span>
                </div>
            </td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-showinfo", "", IconHelper.GetInfoIcon(), "Göster", "showInfoKabinetBazliBolum", kabinet.KabinetBazliBolumID.ToString()))
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-edit", "", IconHelper.GetEditIcon(), "Düzenle", "editKabinetBazliBolum", kabinet.KabinetBazliBolumID.ToString()))
                    @Html.Raw(IconHelper.CreateLink("btn btn-icon btn-delete", "", IconHelper.GetDeleteIcon(), "Sil", "deleteKabinetBazliBolum", kabinet.KabinetBazliBolumID.ToString()))
                </div>
            </td>
        </tr>
    }
</tbody>
