@using Sabim.Domain.DTOs.BolumDtos
@model List<ResultBolumWithBirimCountDto>
<tbody class="text-heading">
    @foreach (var bolum in Model)
    {
        <tr>
            <td>@bolum.BolumAdi</td>
            <td class="text-center"><i class="fas fa-building mr-1 text-secondary"></i>@bolum.BirimSayisi</td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.GetStatusNameIcon(bolum.DurumAdi))
                    <span class="badge badge-lg @BadgeHelper.GetBadgeClass(bolum.DurumId)"> @bolum.DurumAdi</span>
                </div>
            </td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-showinfo", "", IconHelper.GetInfoIcon(), "Göster", "showInfoBolum", bolum.BolumID.ToString()))
                @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-edit", "", IconHelper.GetEditIcon(), "Düzenle", "editBolum", bolum.BolumID.ToString()))
                @Html.Raw(IconHelper.CreateLink("btn btn-icon btn-delete", "", IconHelper.GetDeleteIcon(), "Sil", "deleteBolum", bolum.BolumID.ToString()))
                </div>
            </td>
        </tr>
    }
</tbody>