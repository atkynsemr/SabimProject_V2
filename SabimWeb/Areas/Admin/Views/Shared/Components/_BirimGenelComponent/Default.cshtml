@using Sabim.Domain.DTOs.BirimDtos
@model List<ResultBirimDto>

<div class="form-group">
    <label for="BirimAdi">Bağlı Olduğu Birim</label>
    <select class="form-control" id="birimler" name="BirimID" style="width: 100%;">
        @foreach (var Birim in Model)
        {
            <option value="@Birim.BirimID" selected="@Birim.Selected">@Birim.BirimAdi</option>
        }
    </select>
</div>
