@using Sabim.Domain.DTOs.MalzemeDtos
@model List<ResultMalzemeDto>
<tbody class="text-heading">
    @foreach (var malzeme in Model)
    {
        <tr>
            <td>@malzeme.TurAdi</td>
            <td>@malzeme.MalzemeCinsiAdi</td>
            <td>@malzeme.MarkaAdi</td>
            <td>@malzeme.ModelAdi</td>
            <td>@malzeme.SeriNumarasi</td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.GetStatusNameIcon(malzeme.DurumAdi))
                    <span class="badge badge-lg @BadgeHelper.GetBadgeClass(malzeme.DurumId)"> @malzeme.DurumAdi</span>
                </div>
            </td>
            <td class="text-center">
                <div class="d-flex align-items-center justify-content-center">
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-showinfo", "", IconHelper.GetInfoIcon(), "Göster", "showInfoMalzeme", malzeme.MalzemeID.ToString()))
                    @Html.Raw(IconHelper.CreateActionLink("btn btn-icon btn-edit", "", IconHelper.GetEditIcon(), "Düzenle", "editMalzeme", malzeme.MalzemeID.ToString()))
                    @Html.Raw(IconHelper.CreateLink("btn btn-icon btn-delete", "", IconHelper.GetDeleteIcon(), "Sil", "deleteMalzeme", malzeme.MalzemeID.ToString()))
                </div>
            </td>
        </tr>
    }
</tbody>