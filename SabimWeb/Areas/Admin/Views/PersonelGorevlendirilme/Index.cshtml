<div class="row">
    <div class="col-md-3">
        <div class="card card-primary card-outline">
            <div class="card-body box-profile">
                <div class="text-center">
                    <img class="profile-user-img img-fluid img-circle" src="https://demos.themeselection.com/sneat-bootstrap-html-admin-template/assets/img/avatars/1.png" alt="User profile picture">
                </div>
                <h3 id="PersonelAdiSoyadi" class="profile-username text-center">@Model.ListelePersonelBilgileri.AdSoyad</h3>
                <p class="text-muted text-center">@Model.ListelePersonelBilgileri.UnvanAdi</p>
                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Sicil Numarası</b> <a class="float-right">@Model.ListelePersonelBilgileri.SicilNumarasi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Çalışma Durumu</b> <a class="float-right">@Model.ListelePersonelBilgileri.CalismaDurumAdi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Kadro Yeri</b> <a class="float-right">@Model.ListelePersonelBilgileri.KurumAdi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Bölüm</b> <a class="float-right">@Model.ListelePersonelBilgileri.BolumAdi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Birim</b> <a class="float-right">@Model.ListelePersonelBilgileri.BirimAdi</a>
                    </li>
                    <li class="list-group-item">
                        <b>Kısım</b> <a class="float-right">@Model.ListelePersonelBilgileri.KisimAdi</a>
                    </li>
                </ul>
            </div>
            <!-- /.card-body -->
        </div>
    </div>
    <!-- /.col -->
    <div class="col-md-9">
        <div class="card">
            <div class="d-flex card-header">
                <a asp-area="Admin" asp-controller="Personel" asp-action="Index" class="btn btn-outline-dark btn-flat my-2">
                    <i class="fa fa-arrow-circle-left mr-1"></i> Personeller Sayfasına Dön
                </a>
                @Html.Raw(IconHelper.CreateButton("btn btn-outline-primary btn-flat my-2 ml-auto", "Yeni Personel Görevlendirilme", IconHelper.GetAddIcon(), "Yeni Personel Görevlendirilme Ekle", "createModal"))
            </div>
            <div class="card-body mt-2">
                <div id="PersonelGorevlendirilmeTablosu">
                    <table id="example" class="table table-striped table-bordered table-hover display text-center mt-3" style="width:100%">
                        <thead>
                            <tr>
                                <th>Başlangıç Tarihi</th>
                                <th>Bitiş Tarihi</th>
                                <th>Asıl Görev Yeri Mi</th>
                                <th>Görevlendirilme Durumu</th>
                                <th>Bölüm</th>
                                <th>Birim</th>
                                <th>Kısım</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        @await Component.InvokeAsync("_PersonelGorevlendirilmeComponent", new { personelID = Model.ListelePersonelBilgileri.PersonelID, deger = "result" })
                        <tfoot>
                            <tr>
                                <th>Başlangıç Tarihi</th>
                                <th>Bitiş Tarihi</th>
                                <th>Asıl Görev Yeri Mi</th>
                                <th>Görevlendirilme Durumu</th>
                                <th>Bölüm</th>
                                <th>Birim</th>
                                <th>Kısım</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!-- /.card -->
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/dataTables.searchPanes.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/searchPanes.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/dataTables.colReorder.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/colReorder.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/dataTables.fixedHeader.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/fixedHeader.bootstrap4.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.8/dist/sweetalert2.all.min.js"></script>
        <script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>
    <!-- Toastr -->
    <script src="/AdminTemplate/dist/js/toastr.min.js"></script>
    <!-- Custom Toastr JS-->
    <script src="/AdminTemplate/dist/js/customize/ToastCustom.js"></script>
    <!-- Custom Capitalize JS-->
    <script src="/AdminTemplate/dist/js/customize/CapitalizeCustom.js"></script>
    <!-- Custom SwalAert JS-->
    <script src="/AdminTemplate/dist/js/customize/SwalAlertCustom.js"></script>
    <!-- InputMask -->
    <script src="/AdminTemplate/plugins/jquery/jquery.inputmask.min.js"></script>
    <script>
        $(document).ready(function() {
            initDataTable();
            var selectedBolumId = $('#createBolumler').val();
            if (selectedBolumId) {
                loadBirimComponent(selectedBolumId);
            }
            // Birim bileşenini yükle
            $(document).on("change", "#createBolumler", function() {
                var selectedBolumId = $(this).val();
                if (selectedBolumId) {
                    loadBirimComponent(selectedBolumId);                 
                } 
                else {
                   // $("#birimComponent, #kisimComponent").html(''); // Seçim kaldırılırsa alanları temizle
                    showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
                }
            });
            // Birim seçildiğinde kısım componentini yükle
            $(document).on("change", "#createBirimler", function() {
                var selectedBirimId = $(this).val();
                if (selectedBirimId) {
                    loadKisimComponent(selectedBirimId);
                } else {
                    $("#kisimComponent").html(''); // Seçim kaldırılırsa kısım bileşeni temizle
                }
            });
            $(document).on("change", "#updateBolumler", function () {
                var selectedBolumId = $(this).val();
                if (selectedBolumId) {
                    loadUpdateBirimComponent(selectedBolumId);
                }
                else {
                    // $("#birimComponent, #kisimComponent").html(''); // Seçim kaldırılırsa alanları temizle
                    showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
                }
            });
            // Birim seçildiğinde kısım componentini yükle
            $(document).on("change", "#updateBirimler", function () {
                var selectedBirimId = $(this).val();
                if (selectedBirimId) {
                    loadUpdateKisimComponent(selectedBirimId);
                } else {
                    $("#kisimUpdateComponent").html(''); // Seçim kaldırılırsa kısım bileşeni temizle
                }
            });
            //Kayıt İşlemi
            $('#KaydetPersonelGorevlendirilmeleriButton').click(savePersonelGorevlendirilmeleri);
            $(".modal").on("hidden.bs.modal", function() {
                $('.modal').each(function() {
                    let modal = $(this);
                    let form = modal.find('form');
                    // Eğer form varsa, formu sıfırla
                    if (form.length) {
                        form[0].reset();
                    }
                    // Hata mesajlarını temizle
                    modal.find('span.text-danger').text('');
                });
                $('#createModal .nav-pills .nav-link').removeClass('active'); // Tüm tab'ları deaktif yap
                $('#createModal .tab-content .tab-pane').removeClass('active'); // Tüm içerik alanlarını deaktif yap
                // İlk tab'ı aktif yap
                $('#createModal .nav-pills .nav-link:first').addClass('active');
                $('#createModal .tab-content .tab-pane:first').addClass('active');
               
                // Overlay (arka plan) elemanını gizle
                $('.overlay').hide();
            });
            $('[data-widget="pushmenu"]').on('click', function() {
                setTimeout(function() {
                    var table = $('#example').DataTable();
                    table.columns.adjust().draw(); // Sütunları yeniden boyutlandır ve yeniden çiz
                }, 400); // Animasyon tamamlandıktan sonra
            });
            $(document).one('click', '.btn-edit', function(event) {
                event.preventDefault();
                let id = $(this).data('id');
                if (id) {
                    editPersonelGorevlendirilme(id);
                }
            });
            $(document).on('click', '.btn-showinfo', function(event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    showInfoPersonelGorevlendirilme(id);
                }
            });
            $(document).on('click', '.btn-delete', function(event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let PersonelGorevlendirilmeID = $(this).data('id');
                $.ajax({
                    url: `/Admin/PersonelGorevlendirilme/GetPersonelGorevlendirilmeById/${PersonelGorevlendirilmeID}`,
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            const personelData = response.data;
                            $('#deleteModal #DeletePersonelGorevlendirilmeID').val(personelData.personelGorevlendirilmeID);
                            $('#deleteModal #PersonelGorevlendirilmeGorevlendirilmeBirimAdi').text(personelData.birimAdi);
                            $('#deleteModal #PersonelGorevlendirilmeGorevlendirilmeKisimAdi').text(personelData.kisimAdi);
                            $('#deleteModal #PersonelGorevlendirilmeGorevlendirilmeBaslangicTarihi').text(changeDateFormatTo(personelData.gorevlendirilmeBaslangicTarihi));
                            $('#deleteModal #PersonelGorevlendirilmeGorevlendirilmeBitisTarihi').text(changeDateFormatTo(personelData.gorevlendirilmeBitisTarihi));
                            $('#deleteModal').modal('show'); // Modalı aç
                        } else {
                            showToast('Silinecek veri bulunamadı.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                        }
                    },
                    error: function() {
                        showToast('Silme işlemi için veri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                    }
                });
            });
            $('#datemask').inputmask('dd/mm/yyyy', { 'placeholder': 'dd/mm/yyyy' });
            $('[data-mask]').inputmask();
            // Düzenle Kaydet Butonu
            $('#GuncellePersonelGorevlendirilmeButton').click(saveUpdatedPersonelGorevlendirilme);
            // Sil Modal'ı
            $('#SilPersonelGorevlendirilmeButton').click(deletePersonelGorevlendirilme);
        });
