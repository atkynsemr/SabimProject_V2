@model Sabim.Web.ViewModels.PersonelGorevlendirilmeViewModel
@{
    ViewData["Title"] = "Personel Görevlendirilme";
}
@section StyleCss {
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/searchpanes/2.3.3/css/searchPanes.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/select/2.1.0/css/select.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/4.0.1/css/fixedHeader.bootstrap4.css">
    <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
}
 <!-- Personel Görevlendirilme Ekleme Modal Başlangıç-->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header primary">
                <h5 class="modal-title" id="createModalLabel">Personel Görevlendirilme Ekle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="PersonelGorevlendirilmeEkleForm">
                    @Html.AntiForgeryToken()
                    @await Component.InvokeAsync("_GorevlendirilmeTipiGenelComponent", new { deger = "create" })
                    <div class="form-group">
                        <label>Başlangıç Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="CreateGorevlendirilmeBaslangicTarihi" name="GorevlendirilmeBaslangicTarihi" asp-for="YeniPersonelGorevlendirilme.GorevlendirilmeBaslangicTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="YeniPersonelGorevlendirilme.GorevlendirilmeBaslangicTarihi" name="GorevlendirilmeBaslangicTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Bitiş Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="CreateGorevlendirilmeBitisTarihi" name="GorevlendirilmeBitisTarihi" asp-for="YeniPersonelGorevlendirilme.GorevlendirilmeBitisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="YeniPersonelGorevlendirilme.GorevlendirilmeBitisTarihi" name="GorevlendirilmeBitisTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="AsilGorevlendirilmeYeriMi">Asıl Görev Yeri Mi</label>
                        <div class="form-check">
                            <input type="checkbox" id="CreateAsilGorevlendirilmeYeriMi" name="AsilGorevlendirilmeYeriMi"   data-width="100" data-height="30" data-toggle="toggle" data-on="Evet" data-off="Hayır"
                                   data-onstyle="success" data-offstyle="danger" asp-for="YeniPersonelGorevlendirilme.AsilGorevlendirilmeYeriMi">
                        </div>
                    </div>
@*                     <div class="form-group">
                        <label for="GorevlendirilmeAktifMi">Görevlendirilme Aktif Mi</label>
                        <div class="form-check">
                            <input type="checkbox" id="CreateGorevlendirilmeAktifMi" name="GorevlendirilmeAktifMi" data-width="100" data-height="30" data-toggle="toggle" data-on="Evet" data-off="Hayır"
                                   data-onstyle="success" data-offstyle="danger" asp-for="YeniPersonelGorevlendirilme.GorevlendirilmeAktifMi">
                        </div>
                    </div> *@
                    <div id="bolumComponent">
                        @await Component.InvokeAsync("_BolumGenelComponent", new { deger = "create" })
                    </div>
                    <div id="birimComponent">
                        @await Component.InvokeAsync("_BirimGenelComponent", new { deger = "create", selectedBolumId = (int?)null })
                    </div>
                    <div id="kisimComponent">
                        @await Component.InvokeAsync("_KisimGenelComponent", new { deger = "create", selectedBirimId = (int?)null })
                    </div>
                    <input type="hidden" id="CreatePersonelId" name="PersonelId" asp-for="YeniPersonelGorevlendirilme.PersonelId" value="@Model.ListelePersonelBilgileri.PersonelID" />
                    <input type="hidden" id="CreateDurumId" name="DurumId" asp-for="YeniPersonelGorevlendirilme.DurumId" value="1" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="KaydetPersonelGorevlendirilmeleriButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel Görevlendirilme Ekleme Modal Bitiş-->

<!-- Personel Görevlendirilme Düzenleme Modal Başlangıç-->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel">
    <div class="modal-dialog mw-100 w-75" role="document">
        <div class="modal-content">
