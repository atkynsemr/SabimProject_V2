        const changeDateFormatTo = date => {
            if (!date) return ''; // Eğer tarih yoksa boş döner
            const onlyDate = date.split("T")[0];
            const [yy, mm, dd] = onlyDate.split("-");
            return `${dd}/${mm}/${yy}`;
        };
        // Birim bileşenini yükleyen AJAX fonksiyonu
        function loadBirimComponent(selectedBolumId) {
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/GetBirimComponent',
                type: 'GET',
                data: { selectedBolumId: selectedBolumId },
                success: function(result) {
                    $('#birimComponent').html(result); // Yeni birim bileşenini güncelle
                    var firstBirimId = $('#birimComponent select').first().val();
                    if (firstBirimId) {
                        loadKisimComponent(firstBirimId);
                    } else {
                        showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
                    }
                }
            });
        }
        function loadUpdateBirimComponent(selectedBolumId) {
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/GetBirimComponent',
                type: 'GET',
                data: { selectedBolumId: selectedBolumId },
                success: function (result) {
                    $('#birimUpdateComponent').html(result); // Yeni birim bileşenini güncelle
                    var firstBirimId = $('#birimUpdateComponent select').first().val();
                    if (firstBirimId) {
                        loadUpdateKisimComponent(firstBirimId);
                    } else {
                        showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
                    }
                }
            });
        }
        // Kısım bileşenini yükleyen AJAX fonksiyonu
        function loadKisimComponent(selectedBirimId) {
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/GetKisimComponent',
                type: 'GET',
                data: { selectedBirimId: selectedBirimId },
                success: function(result) {
                    $('#kisimComponent').html(result); // Kısım bileşenini güncelle
                }
            });
        }
        function loadUpdateKisimComponent(selectedBirimId) {
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/GetKisimComponent',
                type: 'GET',
                data: { selectedBirimId: selectedBirimId },
                success: function (result) {
                    $('#kisimUpdateComponent').html(result); // Kısım bileşenini güncelle
                }
            });
        }
        function savePersonelGorevlendirilmeleri() {
            $('#createModal span.text-danger').text('');
            $('#createModal .overlay').show();
            var formData = $('#PersonelGorevlendirilmeEkleForm').serialize(); // Form verilerini serialize et
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/EklePersonelGorevlendirilme', // Hedef URL
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        $('#createModal').modal('hide');
                        reloadTable();
                        if (response.completeStatus) {
                            showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                        }
                        else {
                            showToast(response.message, 'Bilgi Mesajı', 'topRight', 3500, 'bg-warning', true);
                        }
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function editPersonelGorevlendirilme(id) {
            // event.preventDefault();
            $.ajax({
                url: `/Admin/PersonelGorevlendirilme/GetPersonelGorevlendirilmeById/${id}`,
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        const data = response.data;
                         console.log(data);
                        $('#editModal #UpdatePersonelId').val(data.personelId);
                        $('#editModal #UpdatePersonelGorevlendirilmeID').val(data.personelGorevlendirilmeID);
                        $('#editModal #updateGorevlendirilmeTurleri option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.gorevlendirilmeTipiId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #UpdateAsilGorevlendirilmeYeriMi').prop('checked', data.asilGorevlendirilmeYeriMi).bootstrapToggle('destroy').bootstrapToggle();
                        $('#editModal #updateBolumler option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.bolumId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #updateBirimler option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.birimId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #updateKisimlar option').each(function () {
                            const optionValue = $(this).val();
                            if (optionValue == data.kisimId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal #UpdateGorevlendirilmeBaslangicTarihi').val(changeDateFormatTo(data.gorevlendirilmeBaslangicTarihi));
                        $('#editModal #UpdateGorevlendirilmeBitisTarihi').val(changeDateFormatTo(data.gorevlendirilmeBitisTarihi));
                        $('#editModal #updateDurumlar option').each(function() {
                            const optionValue = $(this).val();
                            if (optionValue == data.durumId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal .overlay').hide();
                        $('#editModal').modal('show');
                    }
                    else {
                        showToast('Seçili olan kayıt gösterilemiyor! Lütfen sayfayı yenileyip tekrar deneyiniz.', 'Hata', 'topRight', 3500, 'bg-danger', true);
                        $('.modal .overlay').hide();
                    }
                },
                error: function() {
                    showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu!', 'error', 3500, true, true);
                }
            });
        }
        function saveUpdatedPersonelGorevlendirilme() {
            var formData = $('#PersonelGorevlendirilmeGuncelleForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/GuncellePersonelGorevlendirilme',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        $('#editModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function deletePersonelGorevlendirilme() {
            $('#deleteModal .overlay').show();
            var formData = $('#PersonelGorevlendirilmeSilForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/PersonelGorevlendirilme/SilPersonelGorevlendirilme', // Silme işlemi için endpoint
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        $('#deleteModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        $('#deleteModal').modal('hide');
                        showToast(response.message, 'Hata Mesajı', 'topRight', 3500, 'bg-danger', true);
                    }
                },
                error: function(xhr) {
                    handleError(xhr); // Hata durumunu yönet
                }
            });
        }
        function showInfoPersonelGorevlendirilme(id) {
            $.ajax({
                url: `/Admin/PersonelGorevlendirilme/GetirSafahatBilgi/${id}`,
                type: 'GET',
                success: function(response) {
                    $("#auditTrailModal").find(".modal-body").html(response);
                    $('#auditTrailModal').modal('show');
                },
                error: function() {
                    showToast('Safahat bilgileri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                }
            });
        }
        function reloadComponent(componentSelector, url) {
            $(componentSelector).load(url, function(response, status, xhr) {
                if (status === "error") {
                    setTimeout(function() {
                        window.location.reload(); // Sayfayı yeniden yükle
                    }, 1500);
                }
            });
        }
        function reloadTable() {
            // Eski tabloyu kaldır
            if ($.fn.DataTable.isDataTable('#example')) {
                $('#example').DataTable().destroy();
                $('#example').empty(); // DOM'u temizle
            }
            var personelID = $('#CreatePersonelId').val();
            // Tabloyu yeniden yükle
            $('#PersonelGorevlendirilmeTablosu').load('/Admin/PersonelGorevlendirilme/Index?personelId=' + personelID + ' #PersonelGorevlendirilmeTablosu', function (response, status, xhr) {
                if (status === "success") {
                    initDataTable(); // DataTable başlat
                } else if (status === "error") {
                    showToast("Tablo yüklenemedi. Lütfen sayfayı yenileyin.", "Hata", "topRight", 3500, "bg-danger", true);
                }
            });
        }
        function handleError(xhr) {
            $('.modal .overlay').hide();
            if (xhr.responseJSON && xhr.responseJSON.errors) {
                for (let key in xhr.responseJSON.errors) {
                    let errorElement = $(`[name='${key}']`).next('.text-danger');
                    errorElement.text(xhr.responseJSON.errors[key][0]);
                }
            }
            else {
                $('.modal').modal('hide'); // Tüm açık modalları kapatır
                showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Personeline bildiriniz.', 'error', 6500, true, true);
            }
        }
    </script>
