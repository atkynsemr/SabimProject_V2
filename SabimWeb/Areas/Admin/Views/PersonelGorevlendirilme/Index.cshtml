                    @await Component.InvokeAsync("_GorevlendirilmeTipiGenelComponent", new { deger = "update" })
                    <div class="form-group">
                        <label>Başlangıç Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="UpdateGorevlendirilmeBaslangicTarihi" name="GorevlendirilmeBaslangicTarihi" asp-for="GuncellePersonelGorevlendirilme.GorevlendirilmeBaslangicTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="GuncellePersonelGorevlendirilme.GorevlendirilmeBaslangicTarihi" name="GorevlendirilmeBaslangicTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Bitiş Tarihi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                            </div>
                            <input type="text" class="form-control" id="UpdateGorevlendirilmeBitisTarihi" name="GorevlendirilmeBitisTarihi" asp-for="GuncellePersonelGorevlendirilme.GorevlendirilmeBitisTarihi" data-inputmask-alias="datetime" data-inputmask-inputformat="dd/mm/yyyy" data-mask />
                            <span asp-validation-for="GuncellePersonelGorevlendirilme.GorevlendirilmeBitisTarihi" name="GorevlendirilmeBitisTarihi" class="col-sm-12 text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="AsilGorevlendirilmeYeriMi">Asıl Görev Yeri Mi</label>
                        <div class="form-check">
                            <input type="checkbox" id="UpdateAsilGorevlendirilmeYeriMi" name="AsilGorevlendirilmeYeriMi" data-width="100" data-height="30" data-toggle="toggle" data-on="Evet" data-off="Hayır"
                                   data-onstyle="success" data-offstyle="danger" asp-for="GuncellePersonelGorevlendirilme.AsilGorevlendirilmeYeriMi">
                        </div>
                    </div>
                    @*<div class="form-group">
                    <label for="GorevlendirilmeAktifMi">Görevlendirilme Aktif Mi</label>
                    <div class="form-check">
                    <input type="checkbox" id="UpdateGorevlendirilmeAktifMi" name="GorevlendirilmeAktifMi" data-width="100" data-height="30" data-toggle="toggle" data-on="Evet" data-off="Hayır"
                    data-onstyle="success" data-offstyle="danger" asp-for="GuncellePersonelGorevlendirilme.GorevlendirilmeAktifMi">
                    </div>
                    </div> *@
                    <div id="bolumUpdateComponent">
                        @await Component.InvokeAsync("_BolumGenelComponent", new { deger = "update" })
                    </div>
                    <div id="birimUpdateComponent">
                        @await Component.InvokeAsync("_BirimGenelComponent", new { deger = "update", selectedBolumId = (int?)null })
                    </div>
                    <div id="kisimUpdateComponent">
                        @await Component.InvokeAsync("_KisimGenelComponent", new { deger = "update", selectedBirimId = (int?)null })
                        <span asp-validation-for="GuncellePersonelGorevlendirilme.KisimId" name="KisimId" class="col-sm-12 text-danger"></span>
                    </div>     
                    @await Component.InvokeAsync("_DurumListesiGenelComponent", new { deger = "update" })
                    <input type="hidden" id="UpdatePersonelId" name="PersonelId" asp-for="GuncellePersonelGorevlendirilme.PersonelId" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-warning" id="GuncellePersonelGorevlendirilmeButton">Güncelle</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel Görevlendirilme Düzenleme Modal Bitiş-->

<!-- Personel Görevlendirilme Silme Modal Başlangıç-->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="deleteModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header danger">
                <h5 class="modal-title" id="deleteModalLabel">Personel Görevlendirilme Sil</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="PersonelGorevlendirilmeSilForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PersonelGorevlendirilmeID" id="DeletePersonelGorevlendirilmeID" />
                    <p id="PersonelGorevlendirilmeLabel">
                        Başlangıç Tarihi: <strong id="PersonelGorevlendirilmeGorevlendirilmeBaslangicTarihi"></strong> - Bitiş Tarihi:<strong id="PersonelGorevlendirilmeGorevlendirilmeBitisTarihi"></strong> -
                        Birim: <strong id="PersonelGorevlendirilmeGorevlendirilmeBirimAdi"></strong> - Kısım: <strong id="PersonelGorevlendirilmeGorevlendirilmeKisimAdi"></strong> görevlendirilme silinecektir. Onaylıyor musunuz?</p>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-danger" id="SilPersonelGorevlendirilmeButton">Sil</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Personel Görevlendirilme Silme Modal Bitiş-->

<!-- Personel Görevlendirilme Safahat Modal Başlangıç-->
