@model Sabim.Web.ViewModels.GorevlendirilmeTuruViewModel
@{
    ViewData["Title"] = "Tanımlamalar / Görevlendirilme Türü";
}
@section StyleCss {
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.3/css/responsive.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/searchpanes/2.3.3/css/searchPanes.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/select/2.1.0/css/select.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.bootstrap4.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/4.0.1/css/fixedHeader.bootstrap4.css">
    <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
}

<!-- Görevlendirilme Türü Safahat Modal Başlangıç-->
<div class="modal fade" id="auditTrailModal" tabindex="-1" role="dialog" aria-labelledby="auditTrailModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-secondary">
                <h5 class="modal-title" id="auditTrailModalLabel">Safahat Bilgileri</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--Veriler Yüklenecek-->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Görevlendirilme Türü  Safahat Modal Başlangıç-->
<!-- Görevlendirilme Türü Ekleme Modal Başlangıç-->
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header primary">
                <h5 class="modal-title" id="createModalLabel">Görevlendirilme Türü Ekle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="GorevlendirilmeTuruEkleForm">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="GorevlendirilmeTuruAdi">Görevlendirilme Türü Adı</label>
                        <input type="text" class="form-control capitalize-input" id="gorevlendirilmeTuruAdi" name="GorevlendirilmeTuruAdi" asp-for="YeniGorevlendirilmeTuru.GorevlendirilmeTuruAdi" placeholder="Görevlendirilme Türü Adı Giriniz" maxlength="50" required />
                        <span asp-validation-for="YeniGorevlendirilmeTuru.GorevlendirilmeTuruAdi" name="GorevlendirilmeTuruAdi" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="kurumPersonelListesineDahilMi">Personel Listesinde Gösterilme Durumu</label>
                        <div class="form-check">
                            <input type="checkbox" id="kurumPersonelListesineDahilMi" name="KurumPersonelListesineDahilMi" data-style="w-25" data-toggle="toggle" data-on="Göster" data-off="Gizle" data-onstyle="success" data-offstyle="danger" asp-for="YeniGorevlendirilmeTuru.KurumPersonelListesineDahilMi">
                        </div>
                    </div>
                    <input type="hidden" id="DurumId" name="DurumId" asp-for="YeniGorevlendirilmeTuru.DurumId" value="1" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="KaydetGorevlendirilmeTuruButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Görevlendirilme Türü Ekleme Modal Bitiş-->
<!-- Görevlendirilme Türü Düzenleme Modal Başlangıç-->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="overlay">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header warning">
                <h5 class="modal-title" id="editModalLabel">Görevlendirilme Türü Düzenle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="GorevlendirilmeTuruGuncelleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GorevlendirilmeTuruID" id="GorevlendirilmeTuruID" asp-for="GuncelleGorevlendirilmeTuru.GorevlendirilmeTuruID" />
                    <div class="form-group">
                        <label for="GorevlendirilmeTuruAdi">Görevlendirilme Türü Adı</label>
                        <input type="text" class="form-control capitalize-input" id="gorevlendirilmeTuruAdi" name="GorevlendirilmeTuruAdi" asp-for="GuncelleGorevlendirilmeTuru.GorevlendirilmeTuruAdi" placeholder="Çalışma Durum Adı Giriniz" maxlength="50" required />
                        <span asp-validation-for="GuncelleGorevlendirilmeTuru.GorevlendirilmeTuruAdi" name="GorevlendirilmeTuruAdi" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="kurumPersonelListesineDahilMi">Personel Listesinde Gösterilme Durumu</label>
                        <div class="form-check">
                            <input type="checkbox" id="kurumPersonelListesineDahilMi" name="KurumPersonelListesineDahilMi" data-style="w-25" data-toggle="toggle" data-on="Göster" data-off="Gizle"
                                   data-onstyle="success" data-offstyle="danger" asp-for="GuncelleGorevlendirilmeTuru.KurumPersonelListesineDahilMi">
                        </div>
                    </div>
                    @await Component.InvokeAsync("_DurumListesiGenelComponent")
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-warning" id="GuncelleGorevlendirilmeTuruButton">Güncelle</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Görevlendirilme Türü Düzenleme Modal Bitiş-->
<!-- Görevlendirilme Türü Silme Modal Başlangıç-->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="deleteModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="overlay" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <div class="spinner-border text-light" role="status">
                        <span class="sr-only">Lütfen Bekleyiniz...</span>
                    </div>
                    <div>
                        <span class="text-center text-white">Lütfen Bekleyiniz...</span>
                    </div>
                </div>
            </div>
            <div class="modal-header danger">
                <h5 class="modal-title" id="deleteModalLabel">Görevlendirilme Türü Sil</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form Başlangıcı -->
                <form id="GorevlendirilmeTuruSilForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GorevlendirilmeTuruID" id="GorevlendirilmeTuruID" />
                    <p id="gorevlendirilmeTuruAdiLabel">Görevlendirilme Türü Adı: <strong id="gorevlendirilmeTuruAdi"></strong> silinecektir. Onaylıyor musunuz?</p>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-danger" id="SilGorevlendirilmeTuruButton">Sil</button>
            </div>
        </div>
    </div>
</div>
<!-- ./Görevlendirilme Türü Silme Modal Bitiş-->
<div class="card">
    <div class="card-header text-right">
        @Html.Raw(IconHelper.CreateButton("btn btn-outline-primary btn-flat my-2", "Yeni Görevlendirilme Türü", IconHelper.GetAddIcon(), "Yeni Görevlendirilme Türü Ekle", "createModal"))
    </div>
    <div class="card-body mt-2">
        <div id="GorevlendirilmeTuruTablosu">
            <table id="example" class="table table-bordered table-hover display text-center mt-3" style="width:100%">
                <thead>
                    <tr>
                        <th>Görevlendirilme Tür Adı</th>
                        <th>Personel Listesinde Gösterilme Durumu</th>
                        <th class="text-center">Görevlendirilme Türüne Göre Personel Sayısı</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                @await Component.InvokeAsync("_GorevlendirilmeTuruComponent")
                <tfoot>
                    <tr>
                        <th>Ünvan Adı</th>
                        <th>Personel Listesinde Gösterilme Durumu</th>
                        <th class="text-center">Görevlendirilme Türüne Göre Personel Sayısı</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/dataTables.searchPanes.js"></script>
    <script src="https://cdn.datatables.net/searchpanes/2.3.3/js/searchPanes.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/select/2.1.0/js/select.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/dataTables.colReorder.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.4/js/colReorder.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/dataTables.responsive.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.3/js/responsive.bootstrap4.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/dataTables.fixedHeader.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/4.0.1/js/fixedHeader.bootstrap4.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.8/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>
    <!-- Toastr -->
    <script src="/AdminTemplate/dist/js/toastr.min.js"></script>
    <!-- Custom Toastr JS-->
    <script src="/AdminTemplate/dist/js/customize/ToastCustom.js"></script>
    <!-- Custom Capitalize JS-->
    <script src="/AdminTemplate/dist/js/customize/CapitalizeCustom.js"></script>
    <!-- Custom SwalAert JS-->
    <script src="/AdminTemplate/dist/js/customize/SwalAlertCustom.js"></script>
    <script>
        $(document).ready(function() {
            initDataTable();
            $('[data-widget="pushmenu"]').on('click', function() {
                setTimeout(function() {
                    var table = $('#example').DataTable();
                    table.columns.adjust().draw(); // Sütunları yeniden boyutlandır ve yeniden çiz
                }, 300); // Animasyon tamamlandıktan sonra
            });
            //Kayıt İşlemi
            $('#KaydetGorevlendirilmeTuruButton').click(saveGorevlendirilmeTuru);
            $(document).one('click', '.btn-edit', function(event) {
                event.preventDefault(); // Tekrar tetiklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    editGorevlendirilmeTuru(id);
                }
            });
            $(document).on('click', '.btn-delete', function (event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let gorevlendirilmeTuruID = $(this).data('id'); // Silinecek şehirin ID'sini al
                $.ajax({
                    url: `/Admin/GorevlendirilmeTuru/GetGorevlendirilmeTuruById/${gorevlendirilmeTuruID}`,
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            const gorevlendirilmeTuruData = response.data;
                            $('#deleteModal #GorevlendirilmeTuruID').val(gorevlendirilmeTuruData.gorevlendirilmeTuruID);
                            $('#deleteModal #gorevlendirilmeTuruAdi').text(gorevlendirilmeTuruData.gorevlendirilmeTuruAdi); // Durum adını modalda göster
                            $('#deleteModal').modal('show'); // Modalı aç
                        } else {
                            showToast('Silinecek veri bulunamadı.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                        }
                    },
                    error: function () {
                        showToast('Silme işlemi için veri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                    }
                });
            });
            $(".modal").on("hidden.bs.modal", function() {
                $('.modal').each(function() {
                    let modal = $(this);
                    let form = modal.find('form');
                    // Eğer form varsa, formu sıfırla
                    if (form.length) {
                        form[0].reset();
                    }
                    // Hata mesajlarını temizle
                    modal.find('span.text-danger').text('');
                });
                // Overlay (arka plan) elemanını gizle
                $('.overlay').hide();
            });
            $(document).on('click', '.btn-showinfo', function(event) {
                event.preventDefault(); // Sayfanın yeniden yüklenmesini engelle
                let id = $(this).data('id');
                if (id) {
                    showInfoGorevlendirilmeTuru(id);
                }
            });
            // Düzenle Kaydet Butonu
            $('#GuncelleGorevlendirilmeTuruButton').click(saveUpdatedGorevlendirilmeTuru);
            // Sil Modal'ı
            $('#SilGorevlendirilmeTuruButton').click(deleteGorevlendirilmeTuru);
        });
        function initDataTable() {
            $('#example').DataTable({
                "fixedHeader": true,
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "lengthChange": true,
                "pageLength": 25,
                "order": [[0, 'asc']],
                "language": {
                    "searchPanes": {
                        "emptyPanes": 'Filtreleme Paneli Bulunamadı',
                        "title": {
                            _: 'Seçili Alan - %d',
                            0: ''
                        },
                        "collapseMessage": 'Tümünü Kapat',
                        "showMessage": 'Hepsini Göster',
                        "clearMessage": 'Hepsini Temizle'
                    },
                    "sProcessing": "İşleniyor...",
                    "sLengthMenu": "_MENU_",
                    "sZeroRecords": "Eşleşen Kayıt Bulunmadı",
                    "sInfo": "Toplam _TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "sInfoEmpty": "Kayıt Yok",
                    "emptyTable": "Tabloda veri bulunmamaktadır",
                    "sInfoFiltered": "(toplam _MAX_ kayıttan filtrelendi)",
                    "sSearch": "",
                    "searchPlaceholder": 'Arama Yapınız...',
                    "oPaginate": {
                        "sFirst": "İlk",
                        "sPrevious": "Önceki",
                        "sNext": "Sonraki",
                        "sLast": "Son"
                    }
                },
                colReorder: true,
                layout: {
                    topStart:
                    {
                        buttons:
                            [
                                {
                                    extend: 'searchPanes',
                                    text: '<i class="fa fa-filter mr-1"></i>Filtreleme Paneli',
                                    config: {
                                        cascadePanes: true,
                                        layout: 'columns-2',
                                        orderable: false,
                                        initCollapsed: true
                                    }
                                },
                                {
                                    extend: 'collection',
                                    text: '<i class="fas fa-upload mr-1"></i> Aktar',
                                    buttons:
                                        [
                                            {
                                                extend: 'excel',
                                                text: '<i class="fas fa-file-excel mr-1"></i> Excel',
                                                exportOptions: {
                                                    columns: function(idx, data, node) {
                                                        var table = $(node).closest('table').DataTable();
                                                        var columnHeader = $(node).closest('table').find('thead th').eq(idx).text().trim();

                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakmak istediğiniz sütun adları

                                                        if (excludedColumns.includes(columnHeader)) {
                                                            return false;
                                                        }
                                                        return $(node).is(':visible');
                                                    }
                                                }
                                            },
                                            {
                                                extend: 'pdf',
                                                text: '<i class="fas fa-file-pdf mr-1"></i> PDF',
                                                exportOptions: {
                                                    columns: function(idx, data, node) {
                                                        var table = $(node).closest('table').DataTable();
                                                        var columnHeader = $(node).closest('table').find('thead th').eq(idx).text().trim();

                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakmak istediğiniz sütun adları

                                                        if (excludedColumns.includes(columnHeader)) {
                                                            return false;
                                                        }
                                                        return $(node).is(':visible');
                                                    }
                                                },
                                                customize: function(doc) {
                                                    // Tablonun başlıklarını ve içeriğini ortala
                                                    doc.styles.tableHeader.alignment = 'center';
                                                    doc.content[1].table.body.forEach(function(row) {
                                                        row.forEach(function(cell) {
                                                            cell.alignment = 'center';
                                                        });
                                                    });
                                                    doc.content[1].table.widths = new Array(doc.content[1].table.body[0].length).fill('*');
                                                }
                                            },
                                            {
                                                extend: 'print',
                                                text: '<i class="fas fa-print mr-1"></i> Yazdır',
                                                exportOptions: {
                                                    columns: function(idx, data, node) {
                                                        var table = $(node).closest('table').DataTable();
                                                        var columnHeader = $(node).closest('table').find('thead th').eq(idx).text().trim();

                                                        var excludedColumns = ['İşlemler']; // Dışarıda bırakmak istediğiniz sütun adları

                                                        if (excludedColumns.includes(columnHeader)) {
                                                            return false;
                                                        }
                                                        return $(node).is(':visible');
                                                    }
                                                }
                                            }
                                        ]
                                },
                                {
                                    extend: 'colvis',
                                    columns: function(idx, data, node) {
                                        var table = $(node).closest('table').DataTable();
                                        var columnHeader = table.column(idx).header();

                                        // Header varsa, innerText'e ulaş
                                        if (columnHeader) {
                                            var columnHeaderText = columnHeader.textContent.trim(); // innerText yerine textContent kullanabilirsiniz
                                            // Hariç tutulacak sütun adları
                                            var excludedHeaders = ['Çalışma Durumu Adı'];

                                            // Eğer sütun gizliyse ya da sütun adı hariç tutulanlar arasında değilse, devam et
                                            return table.column(idx).visible() && !excludedHeaders.includes(columnHeaderText);
                                        } else {
                                            // Eğer header bulunamazsa, false döndür
                                            return false;
                                        }
                                    },
                                    text: '<i class="fas fa-columns mr-1"></i> Sütun Görünürlüğü'
                                }
                            ]
                    }
                },
                columnDefs: [
                    {
                        searchPanes: {
                            show: true,
                            dtOpts: {
                                select: {
                                    style: 'multi'
                                },
                                //paging: false,
                                //pagingType: 'numbers',
                                searching: true,
                            }
                        },
                        targets: [0, 3]
                    },
                    {
                        searchPanes: {
                            show: false
                        },
                        targets: '_all'  // Diğer tüm sütunlarda searchPane devre dışı
                    }
                ]
            });
        }
        function saveGorevlendirilmeTuru() {
            $('#createModal span.text-danger').text('');
            $('#createModal .overlay').show();
            var formData = $('#GorevlendirilmeTuruEkleForm').serialize(); // Form verilerini serialize et
            $.ajax({
                url: '/Admin/GorevlendirilmeTuru/EkleGorevlendirilmeTuru', // Hedef URL
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        $('#createModal').modal('hide');
                        reloadTable();
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function editGorevlendirilmeTuru(id) {
            // event.preventDefault();
            $.ajax({
                url: `/Admin/GorevlendirilmeTuru/GetGorevlendirilmeTuruById/${id}`,
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        const data = response.data;
                        $('#editModal #GorevlendirilmeTuruID').val(data.gorevlendirilmeTuruID);
                        $('#editModal #gorevlendirilmeTuruAdi').val(data.gorevlendirilmeTuruAdi);
                        $('#editModal #kurumPersonelListesineDahilMi').prop('checked', data.kurumPersonelListesineDahilMi).bootstrapToggle('destroy').bootstrapToggle();
                        // Durum listesindeki seçili durumu güncelle
                        $('#editModal #durumlar option').each(function() {
                            const optionValue = $(this).val();
                            if (optionValue == data.durumId) {
                                $(this).prop('selected', true);
                            } else {
                                $(this).prop('selected', false);
                            }
                        });
                        $('#editModal .overlay').hide();
                        $('#editModal').modal('show');
                    }
                    else {
                        showToast('Seçili olan kayıt gösterilemiyor! Lütfen sayfayı yenileyip tekrar deneyiniz.', 'Hata', 'topRight', 3500, 'bg-danger', true);
                        $('.modal .overlay').hide();
                    }
                },
                error: function() {
                    showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu!', 'error', 3500, true, true);
                }
            });
        }
        function saveUpdatedGorevlendirilmeTuru() {
            var formData = $('#GorevlendirilmeTuruGuncelleForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/GorevlendirilmeTuru/GuncelleGorevlendirilmeTuru',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        $('#editModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        // Hataları göster
                        for (let key in response.errors) {
                            $(`[name="${key}"]`).next('.text-danger').text(response.errors[key][0]);
                        }
                        $('.modal .overlay').hide();
                    }
                }
            });
        }
        function deleteGorevlendirilmeTuru() {
            $('#deleteModal .overlay').show();
            var formData = $('#GorevlendirilmeTuruSilForm').serialize(); // Form verilerini al
            $.ajax({
                url: '/Admin/GorevlendirilmeTuru/SilGorevlendirilmeTuru', // Silme işlemi için endpoint
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#deleteModal').modal('hide'); // Modalı kapat
                        reloadTable(); // Tabloyu yeniden yükle
                        showToast(response.message, 'Bilgi Mesajı', 'topRight', 2500, 'bg-success', true);
                    }
                    else {
                        $('#deleteModal').modal('hide');
                        showToast(response.message, 'Hata Mesajı', 'topRight', 3500, 'bg-danger', true);
                    }
                },
                error: function (xhr) {
                    handleError(xhr); // Hata durumunu yönet
                }
            });
        }
        function showInfoGorevlendirilmeTuru(id) {
            $.ajax({
                url: `/Admin/GorevlendirilmeTuru/GetirSafahatBilgi/${id}`,
                type: 'GET',
                success: function(response) {
                    $("#auditTrailModal").find(".modal-body").html(response);
                    $('#auditTrailModal').modal('show');
                },
                error: function() {
                    showToast('Safahat bilgileri getirilemedi. Lütfen tekrar deneyiniz.', 'Hata!', 'topRight', 3500, 'bg-danger', true);
                }
            });
        }
        function reloadTable() {
            // Eski tabloyu kaldır
            if ($.fn.DataTable.isDataTable('#example')) {
                $('#example').DataTable().destroy();
                $('#example').empty(); // DOM'u temizle
            }
            // Tabloyu yeniden yükle
            $('#GorevlendirilmeTuruTablosu').load('/Admin/GorevlendirilmeTuru #GorevlendirilmeTuruTablosu', function(response, status, xhr) {
                if (status === "success") {
                    initDataTable(); // DataTable başlat
                } else if (status === "error") {
                    showToast("Tablo yüklenemedi. Lütfen sayfayı yenileyin.", "Hata", "topRight", 3500, "bg-danger", true);
                }
            });
        }
        function handleError(xhr) {
            $('.modal .overlay').hide();
            if (xhr.responseJSON && xhr.responseJSON.errors) {
                for (let key in xhr.responseJSON.errors) {
                    let errorElement = $(`[name='${key}']`).next('.text-danger');
                    errorElement.text(xhr.responseJSON.errors[key][0]);
                }
            }
            else {
                $('.modal').modal('hide'); // Tüm açık modalları kapatır
                showSwalAlert('Hata!', 'Beklenmeyen bir hata oluştu. Lütfen yaptığınız işlemi tekrar deneyiniz. Hatanın devam etmesi durumunda Bilgi İşlem Birimine bildiriniz.', 'error', 6500, true, true);
            }
        }
    </script>

}