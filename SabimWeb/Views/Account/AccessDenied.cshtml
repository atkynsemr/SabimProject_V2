@{
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .container {
            max-width: 600px;
            margin-top: 100px;
        }
        .card {
            border-radius: 8px;
        }
        .message {
            font-size: 1.2em;
            color: #d9534f;
        }
        .icon {
            font-size: 50px;
            color: #d9534f;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card shadow">
            <div class="card-body text-center">
                <div class="icon">
                    <i class="bi bi-exclamation-circle-fill"></i>
                </div>
                <h3 class="card-title">Access Denied</h3>
                <p class="message">You do not have permission to access this page.</p>
                <p>Contact your administrator if you believe this is an error.</p>
                <a href="/" class="btn btn-primary">Go to Home</a>
            </div>
        </div>
    </div>

    <!-- Optional Bootstrap Icons (for the warning icon) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
