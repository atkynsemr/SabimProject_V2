                      ViewContext.RouteData.Values["controller"]?.ToString() == "Bolum" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "CalismaDurumu" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Cinsiyet" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Durum" ||
