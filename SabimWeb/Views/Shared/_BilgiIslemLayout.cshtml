                      ViewContext.RouteData.Values["controller"]?.ToString() == "RolEkranYetki" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Sehir" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "SidebarMenu" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Unvan" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(
                      ViewContext.RouteData.Values["controller"]?.ToString() == "AppRole" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Birim" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Bolum" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "CalismaDurumu" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Cinsiyet" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Durum" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Ekran" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "GorevlendirilmeTuru" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "KabinetBazliBolum" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "KadroTuru" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "KanGrubu" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Kisim" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Kurum" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "KurumTipi" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "RolEkranYetki" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Sehir" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "SidebarMenu" ||
                      ViewContext.RouteData.Values["controller"]?.ToString() == "Unvan" ? "active" : "")">
                                <i class="nav-icon fas fa-server"></i>
                                <p>
                                    Tanımlamalar
                                    <i class="fas fa-angle-left right"></i>
                                    <span class="badge badge-info right">29</span>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Birim" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Birim" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Birim</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Bolum" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bolum" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Bölüm</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Cinsiyet" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cinsiyet" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Cinsiyet</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="CalismaDurumu" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CalismaDurumu" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Çalışma Durumu</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Durum" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Durum" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Durum</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="GorevlendirilmeTuru" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "GorevlendirilmeTuru" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Görevlendirilme Türü</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="KabinetBazliBolum" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KabinetBazliBolum" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Kabinet Bazlı Bölümler</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="KadroTuru" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KadroTuru" ? "active" : "")">
