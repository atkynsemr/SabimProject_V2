                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="KanGrubu" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KanGrubu" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Kan Grubu</p>
