                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RolEkranYetki" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Rol - Ekran Erişimi</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="SidebarMenu" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SidebarMenu" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Sidebar Menu</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Ekran" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ekran" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Sidebar Menu - Ekran</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Sehir" asp-action="Index"
