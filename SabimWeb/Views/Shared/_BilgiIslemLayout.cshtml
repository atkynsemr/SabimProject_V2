                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Kisim" asp-action="Index"
                                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kisim" ? "active" : "")">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Kısım</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Kurum" asp-action="Index"
