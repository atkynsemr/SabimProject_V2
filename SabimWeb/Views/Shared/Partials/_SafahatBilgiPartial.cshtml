@using Sabim.Web.Helpers.HtmlHelpers
@model AuditTrailDto

<div class="row">
    <div class="col-lg-12">
        <div class="shoping__cart__table">
            <table class="table table-striped align-middle mb-0 bg-white" id="example">
                <thead class="bg-light text-center text-dark">
                    <tr>
                        <th>Yapılan İşlem</th>
                        <th>Tarih</th>
                        <th>Personel</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @if (!String.IsNullOrWhiteSpace(Model.OlusturanAdSoyad) && Model.OlusturulmaTarihi.HasValue)
                    {
                        <tr>
                            <td>
                                <p class="fw-normal mb-1 text-primary">@Html.Raw(IconHelper.GetAddIcon()) Eklenme</p>
                            </td>
                            <td>
                                <p class="fw-normal mb-1">@Model.OlusturulmaTarihi?.ToString("dd.MM.yyyy HH:mm")</p>
                            </td>
                            <td>
                                <p class="fw-normal mb-1"><strong>@Model.OlusturanAdSoyad</strong></p>
                            </td>
                        </tr>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.GuncelleyenAdSoyad) && Model.GuncellenmeTarihi.HasValue)
                    {
                        <tr>
                            <td>
                                <p class="fw-normal mb-1 text-orange">@Html.Raw(IconHelper.GetEditIcon()) Güncellenme</p>
                            </td>
                            <td>
                                <p class="fw-normal mb-1">@Model.GuncellenmeTarihi?.ToString("dd.MM.yyyy HH:mm")</p>
                            </td>
                            <td>
                                <p class="fw-normal mb-1"><strong>@Model.GuncelleyenAdSoyad</strong></p>
                            </td>
                        </tr>
                    }
                    @if (!String.IsNullOrWhiteSpace(Model.SilenAdSoyad) && Model.SilinmeTarihi.HasValue)
                    {
                        <tr>
                            <td>
                                <p class="fw-normal mb-1 text-danger">@Html.Raw(IconHelper.GetDeleteIcon()) Silme</p>
                            </td>
                            <td>
                                <p class="fw-normal mb-1">@Model.SilinmeTarihi?.ToString("dd.MM.yyyy HH:mm")</p>
                            </td>
                            <td>
                                <p class="fw-normal mb-1"><strong>@Model.SilenAdSoyad</strong></p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
