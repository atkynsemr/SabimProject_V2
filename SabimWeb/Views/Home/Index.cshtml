@section StyleCss {
    <link rel="stylesheet" href="/AdminTemplate/plugins/datatables/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="/AdminTemplate/plugins/datatables/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="/AdminTemplate/plugins/datatables/css/buttons.bootstrap4.min.css">
    <link rel="stylesheet" href="/AdminTemplate/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
    <style>
        .custom-select-sm {
            font-size: 100%;
            padding-left: .5rem;
            margin-bottom: .5rem;
            margin-left: .5rem;
            margin-right: .5rem;
            height:2.5rem;
            max-height:2.5rem;       
        }

        .btn-icon {
            transition: transform 0.3s ease, background-color 0.3s ease; /* Geçiş efektini ayarlıyoruz */
            border-radius: 5px; /* Arka planın kenarlarını yuvarlamak için */
            padding: 5px; /* Arka planın iconu çevrelemesi için iç boşluk */
        }

            .btn-icon:hover {
                transform: translateY(-5px); /* Hover durumunda yukarı kaydırma */
                background-color:ghostwhite; /* Daha açık bir arka plan rengi (şeffaf siyah) */
            }

        /* Diğer dropdown ayarları */
        .dropdown-item {
            padding: .5rem .5rem .5rem 1rem;
            clear:both;
        }

        /* Aktif öğelerde onay işaretini sağa hizalama */
        .dropdown-item.active,
        .dropdown-item:active {
            color: #212529;
            text-decoration: none;
                background-color: #f9f9f9;
            padding-right: 3rem !important; /* Sağ tarafta boşluk bırak */
            position: relative; /* Absolute konumlandırma için gerekli */
        }

            /* Onay işaretinin konumu */
            .dropdown-item.active:after {
                position: absolute;
                right: 1em;
                display: inline-block;
                content: "✓";
                color: inherit;
                font-weight: bold;
            }


        /* Açılır menü için overflow ayarı */
        .dropdown-menu {
            overflow: hidden;
            white-space: nowrap;
            max-width: 100%;
            position: relative; /* Hover sırasında konumlandırma sorunlarını engeller */
            box-sizing: border-box; /* Padding ve border dahil olarak genişliği belirler */
        }

            /* Uzun metinler için ellipsis efekti */
            .dropdown-menu a {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
            .custom-buttons{
                margin-left:1rem;
                margin-right:1rem;
            }

            .dataTables_filter input[type="search"] {
                padding-top: 1.2rem;  /* Adjust the value as needed */
                padding-bottom: 1.2rem;  /* Adjust the value as needed */
            }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #007bff;
            border-color: #006fe6;
            color: #fff;
            padding: 0 10px;
            margin-top: .31rem;
        }
    </style>
}

