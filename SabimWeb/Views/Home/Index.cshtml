@section Scripts {
    <script src="/AdminTemplate/plugins/jquery/jquery.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/jquery.dataTables.min.js"></script>
    <!-- Select2 -->
    <script src="/AdminTemplate/plugins/select2/js/select2.full.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/dataTables.bootstrap4.min.js"></script> 
    <script src="/AdminTemplate/plugins/datatables/js/dataTables.responsive.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/responsive.bootstrap4.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/dataTables.buttons.min.js"></script> 
    <script src="/AdminTemplate/plugins/datatables/js/buttons.bootstrap4.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/jszip.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/pdfmake.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/vfs_fonts.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/buttons.html5.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/buttons.print.min.js"></script>
    <script src="/AdminTemplate/plugins/datatables/js/buttons.colVis.min.js"></script>
    <script>
        $(document).ready(function() {
              $("#example1").DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "lengthChange": true,
                "lengthMenu": [
                    [10, 25, 50, 75, 100, -1],
                    [10, 25, 50, 75, 100, 'Hepsi']
                ],
                 "buttons": [
                            {
                                extend: 'collection',
                                text: '<i class="fas fa-upload mr-1"></i> Aktar', // Dropdown ana düğme ikonu
                                buttons: [
                                    { 
                                        extend: 'excel', 
                                        text: '<i class="fas fa-file-excel mr-1"></i> Excel',
                                        exportOptions: {
                                        columns: ':visible:not(:eq(4))'
                                        },
                                    },
                                    { 
                                        extend: 'pdf', 
                                        text: '<i class="fas fa-file-pdf mr-1"></i> PDF',
                                        exportOptions: {
                                        columns: [0, 1, 2, 3]
                                            },
                                        customize: function (doc) {
                                        // Tablonun başlıklarını sola hizala
                                        doc.styles.tableHeader.alignment = 'center';

                                        // Tablonun içeriklerini sola hizala
                                        doc.content[1].table.body.forEach(function (row, index) {
                                            row.forEach(function (cell) {
                                                cell.alignment = 'center';
                                            });
                                        });
                                    }
                                    },
                                    { 
                                        extend: 'print', 
                                        text: '<i class="fas fa-print mr-1"></i> Yazdır',
                                        exportOptions: {
                                        columns: ':visible:not(:eq(4))'
                                        },
                                    }
                                ]
                            },
                            {
                                extend: 'colvis',
                                columns: function (idx, data, node) {
                                return [0].indexOf(idx) === -1;
                                },
                                text: '<i class="fas fa-columns mr-1"></i> Sütun Görünürlüğü'
                            }
                        ],
                "order": [[1, 'asc']],
                "language": {
                    "sProcessing": "İşleniyor...",
                    "sLengthMenu": "_MENU_",
                    "sZeroRecords": "Eşleşen Kayıt Bulunmadı",
                    "sInfo": "Toplam _TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "sInfoEmpty": "Kayıt Yok",
                    "sInfoFiltered": "(toplam _MAX_ kayıttan filtrelendi)",
                    "sSearch": "",
                    "searchPlaceholder": 'Arama Yapınız...',
                    "oPaginate": {
                        "sFirst": "İlk",
                        "sPrevious": "Önceki",
                        "sNext": "Sonraki",
                        "sLast": "Son"
                    },
                    "buttons": {
                        "copyTitle": 'Panoya kopyala',
                        "copySuccess": {
                            1: "Panoya bir satır kopyalandı",
                            _: "Panoya %d satır kopyalandı"
                        },
                        "copyKeys": 'Tablo verilerini sistem panonuza kopyalamak için <i>ctrl</i> veya <i>\u2318</i> + <i>C</i> tuşlarına basın.<br><br>İptal etmek için bu mesaja tıklayın veya escape tuşuna basın.'
                    }
                }
            }).buttons().container()
              .addClass('custom-buttons') 
              .appendTo('#example1_filter');

            var unvanlar = new Set();
            var durumlar = new Set();

            // DataTable'ı al
            var table = $('#example1').DataTable();
            var numberOfRows = table.data().length;

            // Tablo verilerini döngü ile oku
            for (var i = 0; i < numberOfRows; i++) {
                var rowData = table.data()[i]; // Satır verilerini al
                unvanlar.add(rowData[0]); // Ünvan Adı'nın olduğu sütun
                var durumHtml = rowData[3]; // HTML içeriği olarak alır
                var tempDiv = document.createElement("div"); // Geçici bir div oluştur
                tempDiv.innerHTML = durumHtml; // HTML'i içine yerleştir
                var durumText = tempDiv.innerText || tempDiv.textContent; // Yalnızca metni al
                durumlar.add(durumText); // Sadece metni sete ekle
            }

            // Sıralı liste oluşturma
            var sortedUnvanlar = [];
            unvanlar.forEach(function(unvan) {
                sortedUnvanlar.push(unvan); // Set'ten elemanları diziye ekle
            });

            // Basit sıralama algoritması (Bubble Sort örneği)
            for (var i = 0; i < sortedUnvanlar.length - 1; i++) {
                for (var j = 0; j < sortedUnvanlar.length - 1 - i; j++) {
                    if (sortedUnvanlar[j] > sortedUnvanlar[j + 1]) {
                        // Elemanları yer değiştir
                        var temp = sortedUnvanlar[j];
                        sortedUnvanlar[j] = sortedUnvanlar[j + 1];
                        sortedUnvanlar[j + 1] = temp;
                    }
                }
            }

            // Ünvan seçeneklerini doldur
            sortedUnvanlar.forEach(function(unvan) {
                $("#unvanSelect").append(new Option(unvan, unvan));
            });


            // Ünvan filtresi
            $('#unvanSelect').on('change', function() {
                var selectedUnvans = $(this).val();
                var durumlarToShow = new Set();

                // Tablodaki satırları kontrol et ve seçilen unvanlara göre durumları filtrele
                if (selectedUnvans) {
                    for (var i = 0; i < numberOfRows; i++) {
                        var rowData = table.data()[i];
                        if (selectedUnvans.includes(rowData[0])) {
                            durumlarToShow.add($(rowData[3]).text().trim());
                        }
                    }
                } else {
                    durumlarToShow = durumlar;
                }

                // Durum select kutusunu yeniden oluştur
                $("#durumSelect").empty().append(new Option("Tümü", ""));
                durumlarToShow.forEach(function(durum) {
                    $("#durumSelect").append(new Option(durum, durum));
                });

                // Verileri filtrele
                table.column(0).search(selectedUnvans ? selectedUnvans.join('|') : '', true, false).draw();
            });

           // Durumları sıralama
            var sortedDurumlar = [];
            durumlar.forEach(function(durum) {
                sortedDurumlar.push(durum); // Set'ten elemanları diziye ekle
            });

            // Bubble Sort ile sıralama
            for (var i = 0; i < sortedDurumlar.length - 1; i++) {
                for (var j = 0; j < sortedDurumlar.length - 1 - i; j++) {
                    if (sortedDurumlar[j] > sortedDurumlar[j + 1]) {
                        // Elemanları yer değiştir
                        var temp = sortedDurumlar[j];
                        sortedDurumlar[j] = sortedDurumlar[j + 1];
                        sortedDurumlar[j + 1] = temp;
                    }
                }
            }

            // Durum seçeneklerini doldur
            sortedDurumlar.forEach(function(durum) {
                $("#durumSelect").append(new Option(durum, durum));
            });


            // Durum filtresi
            $('#durumSelect').on('change', function() {
                var selectedDurums = $(this).val();
                var unvanlarToShow = new Set();

                // Seçilen durumlara göre unvanları filtrele
                if (selectedDurums) {
                    for (var i = 0; i < numberOfRows; i++) {
                        var rowData = table.data()[i];
                        if (selectedDurums.includes($(rowData[3]).text().trim())) {
                            unvanlarToShow.add(rowData[0]);
                        }
                    }
                } else {
                    unvanlarToShow = unvanlar;
                }

                // Ünvan select kutusunu yeniden oluştur
                $("#unvanSelect").empty().append(new Option("Tümü", ""));
                unvanlarToShow.forEach(function(unvan) {
                    $("#unvanSelect").append(new Option(unvan, unvan));
                });

                // Verileri filtrele
                table.column(3).search(selectedDurums ? selectedDurums.join('|') : '', true, false).draw();
            });


            $('#unvanSelect').select2({
                closeOnSelect: false,
                width: '100%'
            });
            $('#durumSelect').select2({
                closeOnSelect: false,
                width: '100%'
            });
        });
    </script>
}
