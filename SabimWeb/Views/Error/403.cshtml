        @@-webkit-keyframes lightShadow {
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: scaleX(1);
            }

            0%, 25%, 50%, 75%, 100% {
                transform: scaleX(0.95);
            }
        }

        @@keyframes lightShadow {
            12.5%, 37.5%, 62.5%, 87.5% {
                transform: scaleX(1);
            }

            0%, 25%, 50%, 75%, 100% {
                transform: scaleX(0.95);
            }
