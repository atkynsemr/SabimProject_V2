        @@-webkit-keyframes fenceAnimation {
            0%, 60%, 100% {
                perspective: calc(500 * var(--unit));
                perspective-origin: 0 0;
                transform: scale(1);
            }

            45%, 50% {
                perspective: calc(150 * var(--unit));
                perspective-origin: 50% 50%;
                transform: scale(1.01);
            }
        }

        @@keyframes fenceAnimation {
            0%, 60%, 100% {
                perspective: calc(500 * var(--unit));
