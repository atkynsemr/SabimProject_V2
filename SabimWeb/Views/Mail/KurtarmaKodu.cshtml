@model ResetPasswordDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="../../dist/img/logo.png" />
    <title>SabimWEB | Şifremi Unuttum Ekranı</title>
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/AdminTemplate/plugins/fontawesome/css/all.min.css">
    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/icheck-bootstrap.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="/AdminTemplate/dist/css/adminlte.min.css">
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="" class="h1"><b>Sabim</b>WEB</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Doğrulama kodunu içeren bir e-posta az önce mail adresinize gönderildi</p>
                <form asp-controller="Mail" asp-action="KurtarmaKodu" id="recoverCodeForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="input-group mb-3">
                        <input type="hidden" asp-for="Id" name="id" value="@Model.Id" />
                        <input type="text" asp-for="recoveryCode" name="recoveryCode" class="form-control" placeholder="Kurtarma Kodu" required
                               maxlength="6" pattern="\d{6}" title="6 haneli kodu giriniz.">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-envelope"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-block">Kurtarma Kodunu Giriniz</button>
                        </div>
                        <!-- /.col -->
                    </div>
                </form>
                <p class="mt-3 mb-1">
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="text-primary font-weight-bolder"><i class="fa fa-home mr-2"></i>Giriş Ekranı</a>
                </p>
            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
    <!-- /.login-box -->
    <!-- jQuery -->
    <script src="/AdminTemplate/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="/AdminTemplate/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="/AdminTemplate/dist/js/adminlte.min.js"></script>
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        @ToastrHelper.Toastr(Html, ViewBag.Message, "Geçersiz Kurtarma Kodu", "error")
    }
    <script>
        $(function () {
            $('#recoverCodeForm').validate({
                rules: {
                    recoveryCode: {
                        required: true
                    }
                },
                messages: {
                    recoveryCode: {
                        required: "Lütfen kurtarma kodunu giriniz"
                    }
                },
                errorElement: 'span',
                errorPlacement: function (error, element) {
                    error.addClass('invalid-feedback');
                    element.closest('.form-group').append(error);
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass('is-invalid');
                }
            });
        });
    </script>
</body>
</html>
