@model ResetPasswordDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SabimWEB | Şifremi Yenileme Ekranı</title>
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/AdminTemplate/plugins/fontawesome/css/all.min.css">
    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="/AdminTemplate/plugins/bootstrap/css/icheck-bootstrap.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="/AdminTemplate/dist/css/adminlte.min.css">
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <!-- Custom style -->
    <link rel="stylesheet" href="/AdminTemplate/dist/css/CustomCss.css">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="" class="h1"><b>Sabim</b>WEB</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Yeni şifrenize yalnızca bir adım kaldı, şifrenizi hemen kurtarın.</p>
                <form asp-area="" asp-controller="Mail" asp-action="SifreYenileme" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" name="id" value="@Model.Id" />
                    <input type="hidden" asp-for="recoveryCode" name="recoveryCode" value="@Model.recoveryCode" />
                    <div class="input-group mb-0">
                        <input type="password" asp-for="NewPassword" class="form-control" placeholder="Şifre" maxlength="10" required />
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row input-group-append mt-0">
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="input-group mb-0 mt-3">
                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifre Tekrarı" maxlength="10" required />
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row input-group-append mt-1">
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-block">Şifreyi Değiştir</button>
                        </div>
                        <!-- /.col -->
                    </div>
                </form>
                <p class="mt-3 mb-1">
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="text-primary font-weight-bolder"><i class="fa fa-home mr-2"></i>Giriş Ekranı</a>
                </p>
            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
    <!-- /.login-box -->
    <!-- jQuery -->
    <script src="/AdminTemplate/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="/AdminTemplate/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="/AdminTemplate/dist/js/adminlte.min.js"></script>
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <!-- Page specific script -->
    <script src="/AdminTemplate/dist/js/custom.js"></script>
    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        @ToastrHelper.Toastr(Html, ViewBag.Message, "Hata", "error")
    }
</body>
</html>
